PORT=5000
NODE_ENV=development

# MongoDB connection string.
# Local dev: run `npm run db` in a separate terminal and use:
#   MONGO_DB_URL=mongodb://127.0.0.1:27017/stocksense?replicaSet=rs0
MONGO_DB_URL=your_mongodb_connection_string

# Resend API key for OTP and alert emails. If left empty in development,
# OTP emails are printed to the server console instead of being sent.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=StockSense <onboarding@resend.dev>

JWT_SECRET=your_jwt_secret
