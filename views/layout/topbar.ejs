<% const isManager = user.role === 'manager'; const nav = typeof navCounts !== 'undefined' ? navCounts : {}; %>
<header id="topbar" class="sticky top-0 z-30 h-16 flex items-center gap-2 sm:gap-3 px-4 sm:px-6 lg:px-8 border-b border-line bg-canvas/85 backdrop-blur-md">
  <button id="sidebar-open" data-sidebar-open type="button" class="lg:hidden btn btn-ghost btn-icon -ml-2" aria-label="Open menu" aria-controls="sidebar" aria-expanded="false">
    <%- icon('menu', 'w-5 h-5') %>
  </button>
  <a href="/dashboard" class="lg:hidden shrink-0" aria-label="StockSense dashboard"><%- include('../partials/logo', { cls: 'w-7 h-7' }) %></a>

  <button id="paletteOpen" type="button" class="group flex-1 min-w-0 max-w-md h-10 flex items-center gap-2.5 px-3 rounded-xl border border-line bg-surface text-sm text-muted shadow-card transition-colors hover:border-line-2 hover:text-ink-2" aria-label="Search or jump to (Ctrl+K)" aria-haspopup="dialog">
    <%- icon('search', 'w-4 h-4 shrink-0 text-muted group-hover:text-ink transition-colors') %>
    <span class="truncate">Search products, references, bins…</span>
    <span class="ml-auto hidden sm:flex items-center gap-1"><kbd class="kbd">Ctrl</kbd><kbd class="kbd">K</kbd></span>
  </button>

  <div class="ml-auto flex items-center gap-1 sm:gap-1.5">
    <div id="onlineAvatars" class="hidden md:flex items-center -space-x-1.5 mr-2" aria-label="People online"></div>

    <button id="themeToggle" type="button" class="btn btn-ghost btn-icon" aria-label="Toggle dark theme" title="Toggle theme">
      <span class="theme-icon dark:hidden"><%- icon('moon', 'w-5 h-5') %></span>
      <span class="theme-icon hidden dark:inline"><%- icon('sun', 'w-5 h-5') %></span>
    </button>

    <button type="button" id="alertBell" class="relative btn btn-ghost btn-icon" aria-label="Stock alerts" aria-haspopup="true" aria-expanded="false" aria-controls="alertPanel">
      <span data-bell-icon class="inline-flex origin-top"><%- icon('bell', 'w-5 h-5') %></span>
      <span data-nav-badge="unreadAlerts" class="absolute top-1 right-1 min-w-[1.05rem] h-[1.05rem] px-1 rounded-full bg-bad text-canvas text-[0.62rem] font-bold font-mono flex items-center justify-center ring-2 ring-canvas <%= nav.unreadAlerts ? '' : 'hidden' %>"><%= nav.unreadAlerts || 0 %></span>
    </button>

    <div class="relative">
      <button id="userMenuButton" type="button" class="flex items-center gap-2.5 h-10 pl-1 pr-1.5 sm:pr-2.5 rounded-xl transition-colors hover:bg-sunken" aria-haspopup="menu" aria-expanded="false" aria-controls="userMenu">
        <span class="avatar <%= isManager ? 'avatar-manager' : 'avatar-staff' %>"><%= initials(user.name) %></span>
        <span class="hidden sm:block text-left leading-tight">
          <span class="block text-sm font-semibold max-w-[9rem] truncate"><%= user.name %></span>
          <span class="block text-[0.7rem] text-muted"><%= isManager ? 'Inventory Manager' : 'Warehouse Staff' %></span>
        </span>
        <%- icon('chevron', 'hidden sm:block w-4 h-4 text-faint') %>
      </button>
      <div id="userMenu" class="popover hidden absolute right-0 top-12 w-64 p-1.5 origin-top-right" role="menu" aria-labelledby="userMenuButton">
        <div class="px-2.5 pt-2 pb-2.5 mb-1 border-b border-line">
          <p class="text-sm font-semibold truncate"><%= user.name %></p>
          <p class="text-xs text-muted truncate"><%= user.email %></p>
        </div>
        <a href="/profile" class="menu-item" role="menuitem"><%- icon('user', 'w-4 h-4') %> My profile</a>
        <a href="/labels?products=all" target="_blank" rel="noopener" class="menu-item" role="menuitem"><%- icon('label', 'w-4 h-4') %> Print all product labels</a>
        <button type="button" class="menu-item" role="menuitem" data-open-shortcuts><%- icon('bolt', 'w-4 h-4') %> Keyboard shortcuts <kbd class="kbd ml-auto">?</kbd></button>
        <a href="/styleguide" class="menu-item" role="menuitem"><%- icon('swatch', 'w-4 h-4') %> Design system</a>
        <div class="px-2.5 pt-2.5 pb-2 mt-1 border-t border-line">
          <p class="mb-2 text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-muted">Theme</p>
          <div class="segmented w-full" role="radiogroup" aria-label="Theme">
            <button type="button" role="radio" data-theme-choice="light" class="flex-1 justify-center"><%- icon('sun', 'w-3.5 h-3.5') %> Light</button>
            <button type="button" role="radio" data-theme-choice="dark" class="flex-1 justify-center"><%- icon('moon', 'w-3.5 h-3.5') %> Dark</button>
            <button type="button" role="radio" data-theme-choice="system" class="flex-1 justify-center"><%- icon('monitor', 'w-3.5 h-3.5') %> Auto</button>
          </div>
        </div>
        <a href="/auth/logout" class="menu-item mt-1 !text-bad" role="menuitem"><%- icon('logout', 'w-4 h-4') %> Sign out</a>
      </div>
    </div>
  </div>
</header>

<!-- Alerts panel (filled by /js/live.js) -->
<div id="alertPanel" class="popover hidden fixed z-50 top-[4.25rem] right-3 sm:right-6 lg:right-8 w-[23rem] max-w-[calc(100vw-1.5rem)] overflow-hidden origin-top-right" role="dialog" aria-label="Stock alerts">
  <div class="flex items-center justify-between px-4 py-3 border-b border-line">
    <p class="panel-title flex items-center gap-2"><%- icon('warning', 'w-4 h-4 text-warn') %> Stock alerts</p>
    <button type="button" id="alertsReadAll" class="text-xs font-semibold text-accent-text hover:underline underline-offset-4">Mark all read</button>
  </div>
  <ul id="alertList" class="max-h-96 overflow-y-auto divide-y divide-line text-sm"></ul>
  <a href="/replenishment" class="flex items-center justify-center gap-1.5 px-4 py-3 border-t border-line bg-surface-2 text-sm font-semibold text-ink-2 hover:text-ink">Open replenishment <%- icon('arrowRight', 'w-4 h-4') %></a>
</div>
