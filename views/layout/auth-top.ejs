<%- include('head') %>
<script src="/js/app.js"></script>
<script src="/js/auth.js"></script>
<div class="min-h-dvh grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]">
  <div class="relative flex flex-col px-5 sm:px-10 py-6">
    <header class="flex items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-2.5" aria-label="StockSense home">
        <%- include('../partials/logo', { cls: 'w-8 h-8' }) %>
        <span class="font-display text-[1.1rem] font-bold tracking-tight">StockSense</span>
      </a>
      <button id="themeToggle" type="button" class="btn btn-ghost btn-icon" aria-label="Toggle dark theme">
        <span class="dark:hidden"><%- icon('moon', 'w-5 h-5') %></span>
        <span class="hidden dark:inline"><%- icon('sun', 'w-5 h-5') %></span>
      </button>
    </header>
    <main id="main-content" class="flex-1 flex items-center justify-center py-10">
      <div class="w-full max-w-[26rem] space-y-7 auth-card">
