<%
  const nav = typeof navCounts !== 'undefined' ? navCounts : {};
  const current = typeof activeNav !== 'undefined' ? activeNav : '';
  const sections = [
    { title: null, items: [
      { key: 'dashboard', href: '/dashboard', label: 'Dashboard', icon: 'dashboard' },
      { key: 'scan', href: '/scan', label: 'Scan & Pick', icon: 'scan' },
    ] },
    { title: 'Inventory', items: [
      { key: 'products', href: '/products', label: 'Products', icon: 'products', badge: 'stockAlerts', accent: true, badgeTitle: 'Products low or out of stock' },
      { key: 'categories', href: '/categories', label: 'Categories', icon: 'categories' },
      { key: 'replenishment', href: '/replenishment', label: 'Replenishment', icon: 'replenish' },
      { key: 'timemachine', href: '/insights/time-machine', label: 'Time Machine', icon: 'history' },
    ] },
    { title: 'Operations', items: [
      { key: 'receipts', href: '/receipts', label: 'Receipts', icon: 'receipts', badge: 'receipt', badgeTitle: 'Receipts to process' },
      { key: 'deliveries', href: '/deliveries', label: 'Delivery Orders', icon: 'deliveries', badge: 'delivery', badgeTitle: 'Deliveries to process' },
      { key: 'transfers', href: '/transfers', label: 'Internal Transfers', icon: 'transfers', badge: 'internal', badgeTitle: 'Transfers to process' },
      { key: 'adjustments', href: '/adjustments', label: 'Stock Counts', icon: 'adjustments', badge: 'adjustment', badgeTitle: 'Counts waiting for approval' },
      { key: 'history', href: '/moves', label: 'Move History', icon: 'timemachine' },
    ] },
    { title: 'Settings', items: [
      { key: 'warehouses', href: '/settings/warehouses', label: 'Warehouses', icon: 'warehouses' },
    ] },
  ];
%>
<aside id="sidebar" class="fixed inset-y-0 left-0 z-40 w-64 flex flex-col bg-canvas border-r border-line -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-out-soft" aria-label="Main navigation">
  <div class="h-16 shrink-0 flex items-center gap-3 px-5">
    <a href="/dashboard" class="group flex items-center gap-2.5 rounded-lg" aria-label="StockSense dashboard">
      <%- include('../partials/logo', { cls: 'w-8 h-8 transition-transform duration-500 ease-spring group-hover:-rotate-6 group-hover:scale-110' }) %>
      <span class="font-display text-[1.15rem] font-bold tracking-tight">StockSense</span>
    </a>
    <button type="button" data-sidebar-close class="lg:hidden ml-auto btn btn-ghost btn-icon btn-sm" aria-label="Close menu"><%- icon('x', 'w-5 h-5') %></button>
  </div>

  <nav class="flex-1 overflow-y-auto px-3 pt-2 pb-4 space-y-5">
    <% sections.forEach((section) => { %>
      <div class="space-y-0.5">
        <% if (section.title) { %>
          <p class="px-3 pb-1.5 text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-muted"><%= section.title %></p>
        <% } %>
        <% section.items.forEach((item) => { const active = current === item.key; const count = item.badge ? nav[item.badge] || 0 : 0; %>
          <a href="<%= item.href %>" class="nav-item group" <%- active ? 'aria-current="page"' : '' %>>
            <span class="<%= active ? 'text-accent-text' : 'text-muted group-hover:text-ink' %> transition-colors"><%- icon(item.icon, 'w-[1.15rem] h-[1.15rem] shrink-0') %></span>
            <span class="flex-1 truncate"><%= item.label %></span>
            <% if (item.badge) { %>
              <span data-nav-badge="<%= item.badge %>" class="nav-badge <%= item.accent ? 'nav-badge-accent' : '' %> <%= count ? '' : 'hidden' %>" title="<%= item.badgeTitle %>"><%= count %></span>
            <% } %>
          </a>
        <% }) %>
      </div>
    <% }) %>
  </nav>

  <!-- Live status -->
  <div class="shrink-0 p-3">
    <div id="liveStatus" class="flex items-center gap-2.5 rounded-xl border border-line bg-surface px-3 py-2.5 text-xs text-muted shadow-card" title="Changes made by anyone appear here instantly">
      <span class="relative flex w-2 h-2"><span data-live-dot class="absolute inline-flex w-full h-full rounded-full bg-faint"></span></span>
      <span data-live-text class="font-medium text-ink-2">Connecting…</span>
    </div>
  </div>
</aside>
