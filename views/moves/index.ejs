<%- include('../layout/app-top') %>
<%
  const query = { ...filters };
  const hasFilters = Object.values(filters).some(Boolean);
  const productName = filters.product ? (products.find((p) => String(p._id) === filters.product) || {}).name : null;
  const scopeName = filters.location ? (locations.find((l) => String(l._id) === filters.location) || {}).fullName : 'all locations';
  const typeLabels = { receipt: 'Receipt', delivery: 'Delivery', internal: 'Transfer', adjustment: 'Count' };
  // Group rows by day (newest first)
  const groups = [];
  moves.forEach((m) => {
    const key = toDateInput(m.date);
    if (!groups.length || groups[groups.length - 1].key !== key) groups.push({ key, date: m.date, rows: [] });
    groups[groups.length - 1].rows.push(m);
  });
  const direction = (m) => {
    const fromIn = m.fromLocation && m.fromLocation.type === 'internal';
    const toIn = m.toLocation && m.toLocation.type === 'internal';
    if (filters.location) return String(m.toLocation && m.toLocation._id) === filters.location ? '+' : '−';
    if (fromIn && toIn) return '⇄';
    return toIn ? '+' : '−';
  };
%>

<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold text-white tracking-tight">Move history</h1>
    <p class="text-sm text-slate-400 mt-1">Every stock movement, as recorded in the ledger.<% if (productName) { %> Running balance of <strong class="text-white"><%= productName %></strong> in <%= scopeName %>.<% } %></p>
  </div>
  <a href="/moves/export.csv<%= buildQuery(query) %>" class="btn btn-secondary"><%- icon('download', 'w-4 h-4') %> Export CSV</a>
</div>

<form method="GET" action="/moves" class="card p-4 grid sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-7 gap-3" role="search" aria-label="Filter moves">
  <select name="product" class="input xl:col-span-2" aria-label="Product">
    <option value="">All products</option>
    <% products.forEach((p) => { %><option value="<%= p._id %>" <%= String(p._id) === filters.product ? 'selected' : '' %>><%= p.name %> (<%= p.sku %>)</option><% }) %>
  </select>
  <select name="location" class="input" aria-label="Location">
    <option value="">All locations</option>
    <% locations.forEach((l) => { %><option value="<%= l._id %>" <%= String(l._id) === filters.location ? 'selected' : '' %>><%= l.fullName %></option><% }) %>
  </select>
  <select name="type" class="input" aria-label="Type">
    <option value="">All types</option>
    <% Object.entries(typeLabels).forEach(([v, l]) => { %><option value="<%= v %>" <%= filters.type === v ? 'selected' : '' %>><%= l %>s</option><% }) %>
  </select>
  <select name="user" class="input" aria-label="Done by">
    <option value="">Anyone</option>
    <% users.forEach((u) => { %><option value="<%= u._id %>" <%= String(u._id) === filters.user ? 'selected' : '' %>><%= u.name %></option><% }) %>
  </select>
  <input type="date" name="from" value="<%= filters.from %>" class="input" aria-label="From date" title="From">
  <input type="date" name="to" value="<%= filters.to %>" class="input" aria-label="To date" title="To">
  <div class="flex gap-2 xl:col-span-7 justify-end">
    <% if (hasFilters) { %><a href="/moves" class="btn btn-secondary">Clear</a><% } %>
    <button type="submit" class="btn btn-primary">Apply</button>
  </div>
</form>

<div class="card overflow-hidden transition-shadow" data-live-region="moves">
  <% if (moves.length === 0) { %>
    <p class="p-12 text-center text-slate-400"><%= hasFilters ? 'No moves match these filters' : 'No stock has moved yet' %></p>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-slate-900/80">
          <tr>
            <th class="th">Time</th>
            <th class="th">Reference</th>
            <th class="th">Product</th>
            <th class="th">From → To</th>
            <th class="th text-right">Quantity</th>
            <th class="th text-right">Value</th>
            <% if (balances) { %><th class="th text-right" title="On hand after this move">Balance</th><% } %>
            <th class="th">By</th>
          </tr>
        </thead>
        <% groups.forEach((g) => { %>
          <tbody>
            <tr class="bg-slate-900/60 border-t border-slate-800">
              <th colspan="<%= balances ? 8 : 7 %>" class="px-4 py-2 text-left text-xs font-semibold text-slate-300"><%= fmtDate(g.date) %> <span class="font-normal text-slate-500">· <%= fmtRelativeDays(g.date) %> · <%= g.rows.length %> move<%= g.rows.length === 1 ? '' : 's' %></span></th>
            </tr>
            <% g.rows.forEach((m) => { const dir = direction(m); const tone = dir === '+' ? 'text-emerald-400' : dir === '−' ? 'text-red-400' : 'text-blue-300'; const cost = m.product ? m.product.unitCost || 0 : 0; %>
              <tr class="border-t border-slate-800/60 hover:bg-slate-800/30">
                <td class="td text-slate-400 whitespace-nowrap"><%= new Date(m.date).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %></td>
                <td class="td whitespace-nowrap"><a href="/operations/<%= m.operation %>" class="font-mono text-blue-300 hover:text-blue-200"><%= m.reference %></a><div class="text-[11px] text-slate-500"><%= typeLabels[m.operationType] %></div></td>
                <td class="td"><a href="/moves<%= buildQuery(query, { product: m.product ? m.product._id : '', page: null }) %>" class="text-white hover:text-blue-300"><%= m.product ? m.product.name : '—' %></a></td>
                <td class="td text-slate-300 whitespace-nowrap"><%= m.fromLocation.fullName %> <span class="text-slate-500">→</span> <%= m.toLocation.fullName %></td>
                <td class="td text-right tabular-nums font-semibold <%= tone %>"><%= dir %> <%= fmtQty(m.quantity) %> <span class="text-xs font-normal text-slate-500"><%= m.product ? m.product.uom : '' %></span></td>
                <td class="td text-right tabular-nums text-slate-400"><%= cost ? fmtMoney(m.quantity * cost) : '—' %></td>
                <% if (balances) { %><td class="td text-right tabular-nums text-white"><%= fmtQty(balances.get(String(m._id))) %></td><% } %>
                <td class="td text-slate-400"><%= m.user ? m.user.name : '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        <% }) %>
      </table>
    </div>
    <%- include('../partials/pagination', { pagination, query, noun: 'moves' }) %>
  <% } %>
</div>

<%- include('../layout/app-bottom') %>
