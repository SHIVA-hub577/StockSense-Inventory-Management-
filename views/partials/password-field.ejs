<%# Password input with show / hide. Locals: id, name, label, autocomplete, placeholder, minlength, strength (meter id, optional), extra (optional label-row HTML) %>
<div>
  <div class="flex items-center justify-between mb-1.5">
    <label for="<%= id %>" class="label !mb-0"><%= label %></label>
    <% if (typeof extra !== 'undefined' && extra) { %><%- extra %><% } %>
  </div>
  <div class="relative">
    <input type="password" id="<%= id %>" name="<%= name %>" required <%= typeof minlength !== 'undefined' && minlength ? `minlength=${minlength}` : '' %> autocomplete="<%= autocomplete %>" placeholder="<%= typeof placeholder !== 'undefined' ? placeholder : '••••••••' %>" class="input h-12 pr-12" <%- typeof strength !== 'undefined' && strength ? `data-strength="${strength}"` : '' %>>
    <button type="button" class="absolute right-1.5 top-1/2 -translate-y-1/2 btn btn-ghost btn-icon btn-sm" data-reveal-password aria-controls="<%= id %>" aria-pressed="false" aria-label="Show password">
      <svg data-eye-open class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      <svg data-eye-closed class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88"/></svg>
    </button>
  </div>
  <% if (typeof strength !== 'undefined' && strength) { %>
    <div id="<%= strength %>" class="mt-2.5 space-y-2" aria-live="polite">
      <div class="flex gap-1.5"><span data-bar></span><span data-bar></span><span data-bar></span><span data-bar></span></div>
      <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
        <span data-label></span>
        <span class="flex gap-3 text-[0.7rem]">
          <span data-check="length" class="text-muted"><span data-mark>·</span> 8+ chars</span>
          <span data-check="number" class="text-muted"><span data-mark>·</span> number</span>
          <span data-check="mixed" class="text-muted"><span data-mark>·</span> Aa</span>
          <span data-check="symbol" class="text-muted"><span data-mark>·</span> symbol</span>
        </span>
      </div>
    </div>
  <% } %>
</div>
