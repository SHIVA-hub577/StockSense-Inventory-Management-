<%# Expects: pagination { page, pages, total, from, to }, query (current filters), noun %>
<% if (pagination.total > 0) { %>
  <div class="flex flex-col sm:flex-row items-center justify-between gap-3 px-4 py-3 border-t border-slate-800 text-sm">
    <p class="text-slate-400">
      Showing <span class="font-semibold text-slate-200"><%= pagination.from %>–<%= pagination.to %></span>
      of <span class="font-semibold text-slate-200"><%= pagination.total %></span> <%= noun %>
    </p>
    <% if (pagination.pages > 1) { %>
      <nav class="flex items-center gap-2" aria-label="Pagination">
        <% if (pagination.page > 1) { %>
          <a class="btn btn-secondary btn-sm" href="<%= buildQuery(query, { page: pagination.page - 1 }) %>">← Previous</a>
        <% } %>
        <span class="text-slate-400">Page <%= pagination.page %> of <%= pagination.pages %></span>
        <% if (pagination.page < pagination.pages) { %>
          <a class="btn btn-secondary btn-sm" href="<%= buildQuery(query, { page: pagination.page + 1 }) %>">Next →</a>
        <% } %>
      </nav>
    <% } %>
  </div>
<% } %>
