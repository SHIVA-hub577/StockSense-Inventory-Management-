<%- include('../layout/app-top') %>
<%
  const isEdit = Boolean(operation);
  const op = operation || {};
  const idOf = (v) => (v && v._id ? String(v._id) : v ? String(v) : '');
  const isManager = user.role === 'manager';
  const locationsByWarehouse = {};
  locations.forEach((l) => {
    const key = l.warehouse ? `${l.warehouse.name} (${l.warehouse.code})` : 'Other';
    (locationsByWarehouse[key] = locationsByWarehouse[key] || []).push(l);
  });
  const selectedLocation = isEdit ? idOf(op.sourceLocation) : prefill.location;
%>

<nav class="flex items-center gap-1.5 text-sm text-muted" aria-label="Breadcrumb">
  <a href="/adjustments" class="hover:text-ink">Stock counts</a> <%- icon('chevronRight', 'w-3.5 h-3.5') %>
  <% if (isEdit) { %><a href="/operations/<%= op._id %>" class="hover:text-ink font-mono"><%= op.reference %></a> <%- icon('chevronRight', 'w-3.5 h-3.5') %> <span class="text-ink font-medium">Edit</span>
  <% } else { %><span class="text-ink font-medium">New count</span><% } %>
</nav>

<header class="flex items-center gap-4" data-reveal>
  <span class="tile w-12 h-12 rounded-2xl bg-ink text-canvas shadow-card"><%- icon('adjustments', 'w-6 h-6') %></span>
  <div>
    <p class="eyebrow"><%= isEdit ? 'Edit count' : 'New stock count' %></p>
    <h1 class="page-title mt-0.5"><%= isEdit ? op.reference : 'Count the shelf' %></h1>
    <p class="text-sm text-muted mt-1">Count what is physically on the shelf. Differences are booked when an Inventory Manager applies the count.</p>
  </div>
</header>

<form id="countForm" class="space-y-6" novalidate>
  <div id="formError" class="hidden rounded-xl border border-bad/30 bg-bad-soft p-3 text-sm font-medium text-bad" role="alert"></div>

  <section class="card p-5 sm:p-6 grid md:grid-cols-3 gap-5" data-reveal>
    <div>
      <label for="location" class="label">Location counted *</label>
      <select id="location" name="location" class="input" required>
        <option value="">Choose a location</option>
        <% Object.entries(locationsByWarehouse).forEach(([warehouseName, locs]) => { %>
          <optgroup label="<%= warehouseName %>">
            <% locs.forEach((l) => { %><option value="<%= l._id %>" <%= selectedLocation === String(l._id) ? 'selected' : '' %>><%= l.fullName %></option><% }) %>
          </optgroup>
        <% }) %>
      </select>
    </div>
    <div>
      <label for="scheduledDate" class="label">Count date</label>
      <input id="scheduledDate" name="scheduledDate" type="date" class="input" value="<%= toDateInput(op.scheduledDate) %>">
    </div>
    <div class="flex items-end">
      <label class="flex items-start gap-3 rounded-xl border border-line-2 bg-surface-2 px-3 py-2.5 w-full cursor-pointer select-none <%= isManager ? '' : 'opacity-70 cursor-not-allowed' %>">
        <input type="checkbox" id="blindCount" class="mt-0.5" <%= op.blindCount ? 'checked' : '' %> <%= isManager ? '' : 'disabled' %>>
        <span class="text-sm font-medium">Blind count<span class="block text-xs font-normal text-muted"><%= isManager ? 'Hide recorded quantities from counters' : 'Set by an Inventory Manager' %></span></span>
      </label>
    </div>
    <div class="md:col-span-3">
      <label for="notes" class="label">Notes</label>
      <input id="notes" name="notes" class="input" maxlength="500" value="<%= op.notes || '' %>" placeholder="e.g. Monthly cycle count, rack A">
    </div>
  </section>

  <section class="card" data-reveal>
    <div class="panel-head flex-wrap">
      <div class="min-w-[12rem] flex-1">
        <h2 class="panel-title">Count sheet</h2>
        <div class="mt-2 flex items-center gap-3">
          <span class="h-1.5 flex-1 max-w-[14rem] rounded-full bg-sunken overflow-hidden" aria-hidden="true"><span id="countProgressBar" class="block h-full rounded-full bg-accent transition-[width] duration-500 ease-out-soft" style="width: 0%"></span></span>
          <span id="countProgress" class="text-xs font-medium text-muted" aria-live="polite">Nothing on the sheet yet</span>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        <button type="button" id="loadExpected" class="btn btn-secondary btn-sm"><%- icon('warehouses', 'w-3.5 h-3.5') %> Load products stored here</button>
        <button type="button" id="copyRecorded" class="btn btn-secondary btn-sm" data-recorded-only>Counted = recorded</button>
        <button type="button" id="zeroAll" class="btn btn-secondary btn-sm" title="Start from zero and count by scanning">Start from zero</button>
      </div>
    </div>
    <div class="overflow-x-auto sm:overflow-visible">
      <table class="table">
        <thead>
          <tr>
            <th class="th w-2/5 min-w-[15rem]">Product</th>
            <th class="th text-right" data-recorded-only>Recorded</th>
            <th class="th w-36 text-right">Counted</th>
            <th class="th text-right" data-recorded-only>Difference</th>
            <th class="th text-right" data-recorded-only>Value</th>
            <th class="th w-44">Reason</th>
            <th class="th"><span class="sr-only">Remove</span></th>
          </tr>
        </thead>
        <tbody id="lines"></tbody>
        <tfoot data-recorded-only>
          <tr>
            <td class="td text-right text-muted border-t border-line-2" colspan="3">Net difference value</td>
            <td class="td border-t border-line-2"></td>
            <td class="td text-right font-mono font-semibold tabular border-t border-line-2" id="totalValue">₹0</td>
            <td class="td border-t border-line-2" colspan="2"></td>
          </tr>
        </tfoot>
      </table>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3 border-t border-line bg-surface-2 rounded-b-2xl">
      <button type="button" id="addLine" class="btn btn-secondary btn-sm"><%- icon('plus', 'w-4 h-4') %> Add product</button>
      <p class="hidden sm:flex items-center gap-1.5 text-xs text-muted"><kbd class="kbd">Enter</kbd> next row <kbd class="kbd">Shift</kbd>+<kbd class="kbd">Enter</kbd> previous</p>
    </div>
  </section>

  <div class="flex flex-col-reverse sm:flex-row justify-end gap-3">
    <a href="<%= isEdit ? '/operations/' + op._id : '/adjustments' %>" class="btn btn-ghost">Cancel</a>
    <button type="submit" class="btn btn-secondary" data-submit="draft">Save draft</button>
    <button type="submit" class="btn btn-accent" data-submit="confirm" data-magnetic><%- icon('check', 'w-4 h-4') %> Save &amp; submit for approval</button>
  </div>
</form>

<script type="application/json" id="countFormData"><%- jsonForScript({
  operationId: isEdit ? String(op._id) : null,
  isManager,
  products,
  lines: isEdit ? op.lines.map((l) => ({ product: idOf(l.product), quantity: l.quantity, reason: l.reason || 'count' })) : [],
  prefillProduct: prefill.product,
  reasons: REASON_META,
}) %></script>
<script src="/js/combobox.js"></script>
<script src="/js/count-sheet.js"></script>

<%- include('../layout/app-bottom') %>
