<%- include('../layout/app-top') %>
<%
  const isEdit = Boolean(operation);
  const op = operation || {};
  const idOf = (v) => (v && v._id ? String(v._id) : v ? String(v) : '');
  const needsSource = type === 'delivery' || type === 'internal';
  const needsDest = type === 'receipt' || type === 'internal';
  const locationsByWarehouse = {};
  locations.forEach((l) => {
    const key = l.warehouse ? `${l.warehouse.name} (${l.warehouse.code})` : 'Other';
    (locationsByWarehouse[key] = locationsByWarehouse[key] || []).push(l);
  });
  const locationSelect = (name, label, selected, help) => ({ name, label, selected, help });
  const selects = [];
  if (needsSource) selects.push(locationSelect('sourceLocation', type === 'internal' ? 'From location *' : 'Ship from *', idOf(op.sourceLocation), 'Stock is taken from here'));
  if (needsDest) selects.push(locationSelect('destLocation', type === 'internal' ? 'To location *' : 'Receive into *', idOf(op.destLocation), 'Stock is added here'));
  const initialLines = isEdit
    ? op.lines.map((l) => ({ product: idOf(l.product), quantity: l.quantity }))
    : prefill.lines;
  const iconName = { receipt: 'receipts', delivery: 'deliveries', internal: 'transfers' }[type];
%>

<nav class="flex items-center gap-1.5 text-sm text-muted" aria-label="Breadcrumb">
  <a href="/<%= meta.slug %>" class="hover:text-ink"><%= meta.plural %></a> <%- icon('chevronRight', 'w-3.5 h-3.5') %>
  <% if (isEdit) { %><a href="/operations/<%= op._id %>" class="hover:text-ink font-mono"><%= op.reference %></a> <%- icon('chevronRight', 'w-3.5 h-3.5') %> <span class="text-ink font-medium">Edit</span>
  <% } else { %><span class="text-ink font-medium">New</span><% } %>
</nav>

<header class="flex items-center gap-4" data-reveal>
  <span class="tile w-12 h-12 rounded-2xl bg-ink text-canvas shadow-card"><%- icon(iconName, 'w-6 h-6') %></span>
  <div>
    <p class="eyebrow"><%= isEdit ? 'Edit draft' : 'New ' + meta.label.toLowerCase() %></p>
    <h1 class="page-title mt-0.5"><%= isEdit ? op.reference : type === 'receipt' ? 'Receive goods' : type === 'delivery' ? 'Ship to a customer' : 'Move stock' %></h1>
  </div>
</header>

<form id="operationForm" class="space-y-6" novalidate>
  <div id="formError" class="hidden rounded-xl border border-bad/30 bg-bad-soft p-3 text-sm font-medium text-bad" role="alert"></div>

  <section class="card p-5 sm:p-6 grid md:grid-cols-2 gap-5" data-reveal>
    <div>
      <label for="partner" class="label"><%= meta.partnerLabel %><%= type === 'internal' ? '' : ' *' %></label>
      <input id="partner" name="partner" class="input" list="partnerList" maxlength="200" value="<%= op.partner || '' %>"
             placeholder="<%= type === 'receipt' ? 'e.g. Tata Steel' : type === 'delivery' ? 'e.g. Acme Builders' : 'Optional' %>" autocomplete="off">
      <datalist id="partnerList">
        <% partners.forEach((name) => { %><option value="<%= name %>"></option><% }) %>
      </datalist>
    </div>
    <div>
      <label for="scheduledDate" class="label">Scheduled date</label>
      <input id="scheduledDate" name="scheduledDate" type="date" class="input" value="<%= toDateInput(op.scheduledDate) %>">
    </div>
    <% selects.forEach((s) => { %>
      <div>
        <label for="<%= s.name %>" class="label"><%= s.label %></label>
        <select id="<%= s.name %>" name="<%= s.name %>" class="input" required>
          <option value="">Choose a location</option>
          <% Object.entries(locationsByWarehouse).forEach(([warehouseName, locs]) => { %>
            <optgroup label="<%= warehouseName %>">
              <% locs.forEach((l) => { %>
                <option value="<%= l._id %>" <%= s.selected === String(l._id) ? 'selected' : '' %>><%= l.fullName %></option>
              <% }) %>
            </optgroup>
          <% }) %>
        </select>
        <p class="text-xs text-muted mt-1.5"><%= s.help %></p>
      </div>
    <% }) %>
    <div class="md:col-span-2">
      <label for="notes" class="label">Notes</label>
      <textarea id="notes" name="notes" rows="2" maxlength="500" class="input" placeholder="Optional instructions or references"><%= op.notes || '' %></textarea>
    </div>
  </section>

  <section class="card" data-reveal>
    <div class="panel-head">
      <div>
        <h2 class="panel-title">Products</h2>
        <p class="text-xs text-muted" id="lineTotals" aria-live="polite">No products yet</p>
      </div>
      <% if (needsSource) { %><p class="hidden sm:block text-xs text-muted" id="availabilityHint">Availability is checked at the source location.</p><% } %>
    </div>
    <div class="overflow-x-auto sm:overflow-visible">
      <table class="table">
        <thead>
          <tr>
            <th class="th w-1/2 min-w-[16rem]">Product</th>
            <th class="th w-40">Quantity</th>
            <th class="th">Unit</th>
            <% if (needsSource) { %><th class="th">Available</th><% } %>
            <th class="th"><span class="sr-only">Remove</span></th>
          </tr>
        </thead>
        <tbody id="lines"></tbody>
      </table>
    </div>
    <div class="px-4 py-3 border-t border-line bg-surface-2 rounded-b-2xl">
      <button type="button" id="addLine" class="btn btn-secondary btn-sm"><%- icon('plus', 'w-4 h-4') %> Add product</button>
    </div>
  </section>

  <div class="flex flex-col-reverse sm:flex-row justify-end gap-3">
    <a href="<%= isEdit ? '/operations/' + op._id : '/' + meta.slug %>" class="btn btn-ghost">Cancel</a>
    <button type="submit" class="btn btn-secondary" data-submit="draft">Save as draft</button>
    <button type="submit" class="btn btn-accent" data-submit="confirm" data-magnetic><%- icon('check', 'w-4 h-4') %> Save &amp; mark as To Do</button>
  </div>
</form>

<script type="application/json" id="operationFormData"><%- jsonForScript({
  type,
  operationId: isEdit ? String(op._id) : null,
  needsSource,
  products,
  lines: initialLines,
}) %></script>
<script src="/js/combobox.js"></script>
<script src="/js/operation-form.js"></script>

<%- include('../layout/app-bottom') %>
