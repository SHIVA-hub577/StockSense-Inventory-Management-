<%- include('../layout/app-top') %>
<%
  const base = '/' + meta.slug;
  const query = { tab: filters.tab, warehouse: filters.warehouse, search: filters.search, late: filters.late };
  const hasFilters = filters.warehouse || filters.search || filters.late;
  const iconName = { receipt: 'receipts', delivery: 'deliveries', internal: 'transfers', adjustment: 'adjustments' }[type];
  const art = { receipt: 'truck', delivery: 'truck', internal: 'bins', adjustment: 'clipboard' }[type];
  const isCount = type === 'adjustment';
  const productSummary = (op) => {
    const names = op.lines.map((l) => (l.product ? l.product.name : 'Unknown product'));
    return names.slice(0, 2).join(', ') + (names.length > 2 ? ` +${names.length - 2} more` : '');
  };
%>

<header class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
  <div class="flex items-center gap-4" data-reveal>
    <span class="tile w-12 h-12 rounded-2xl bg-ink text-canvas shadow-card"><%- icon(iconName, 'w-6 h-6') %></span>
    <div>
      <p class="eyebrow">Operations</p>
      <h1 class="page-title mt-0.5"><%= meta.plural %></h1>
      <p class="text-sm text-muted mt-1"><%= meta.description %></p>
    </div>
  </div>
  <a href="<%= base %>/new" class="btn btn-accent" data-magnetic><%- icon('plus', 'w-4 h-4') %> New <%= meta.label %></a>
</header>

<!-- Status tabs + filters -->
<div class="flex flex-col xl:flex-row xl:items-center gap-3">
  <div class="segmented max-w-full overflow-x-auto scrollbar-none" role="tablist" aria-label="Status">
    <% Object.entries(tabs).forEach(([key, tab]) => { const active = filters.tab === key; %>
      <a href="<%= base %><%= buildQuery(query, { tab: key, page: null }) %>" role="tab" aria-selected="<%= active %>">
        <%= tab.label %>
        <span class="count-chip"><%= tabCounts[key] || 0 %></span>
      </a>
    <% }) %>
  </div>

  <form method="GET" action="<%= base %>" class="flex flex-1 flex-col sm:flex-row gap-2 xl:justify-end" role="search">
    <input type="hidden" name="tab" value="<%= filters.tab %>">
    <div class="relative flex-1 xl:max-w-xs">
      <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted"><%- icon('search', 'w-4 h-4') %></span>
      <input type="search" name="search" value="<%= filters.search %>" class="input input-sm pl-9" placeholder="Reference, <%= meta.partnerLabel.toLowerCase() %> or product" aria-label="Search">
    </div>
    <select name="warehouse" class="input input-sm sm:w-52" aria-label="Warehouse">
      <option value="">All warehouses</option>
      <% warehouses.forEach((w) => { %>
        <option value="<%= w._id %>" <%= String(w._id) === filters.warehouse ? 'selected' : '' %>><%= w.name %> (<%= w.code %>)</option>
      <% }) %>
    </select>
    <label class="inline-flex items-center gap-2 h-9 px-3 rounded-[0.6rem] border border-line-2 bg-surface text-sm cursor-pointer select-none whitespace-nowrap">
      <input type="checkbox" name="late" value="1" <%= filters.late ? 'checked' : '' %>>
      Late only <span class="badge <%= lateCount ? 'badge-bad' : 'badge-neutral' %> badge-plain"><%= lateCount %></span>
    </label>
    <div class="flex gap-2">
      <button type="submit" class="btn btn-primary btn-sm h-9 flex-1 sm:flex-none">Apply</button>
      <% if (hasFilters) { %><a href="<%= base %>?tab=<%= filters.tab %>" class="btn btn-ghost btn-sm h-9">Clear</a><% } %>
    </div>
  </form>
</div>

<div class="card overflow-hidden" data-live-region="list" data-reveal>
  <% if (operations.length === 0) { %>
    <%- include('../partials/empty', {
      art,
      title: hasFilters ? `No ${meta.plural.toLowerCase()} match these filters` : filters.tab === 'todo' ? 'Nothing to do - all caught up' : `No ${tabs[filters.tab].label.toLowerCase()} ${meta.plural.toLowerCase()}`,
      text: filters.tab === 'todo' && !hasFilters ? 'New work shows up here the moment anyone creates it.' : '',
      action: `<a href="${base}/new" class="btn btn-secondary btn-sm">Create a ${meta.label.toLowerCase()}</a>`,
    }) %>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="table table-hover">
        <thead>
          <tr>
            <th class="th">Reference</th>
            <th class="th"><%= isCount ? 'Location counted' : type === 'internal' ? 'Route' : meta.partnerLabel %></th>
            <% if (type !== 'internal' && !isCount) { %><th class="th"><%= type === 'receipt' ? 'Destination' : 'Source' %></th><% } %>
            <th class="th">Products</th>
            <th class="th">Scheduled</th>
            <th class="th">Status</th>
          </tr>
        </thead>
        <tbody>
          <% operations.forEach((op) => { const late = isLate(op); %>
            <tr class="cursor-pointer" onclick="if (!event.target.closest('a')) window.location='/operations/<%= op._id %>'">
              <td class="td whitespace-nowrap">
                <a href="/operations/<%= op._id %>" class="ref"><%= op.reference %></a>
                <% if (type === 'delivery' && op.status === 'ready') { const stage = op.packedAt ? 2 : op.pickedAt ? 1 : 0; %>
                  <div class="mt-1 flex items-center gap-1 text-[11px] text-muted" title="Pick → pack → ship">
                    <span class="w-1.5 h-1.5 rounded-full <%= stage >= 1 ? 'bg-ok' : 'bg-line-2' %>"></span>
                    <span class="w-1.5 h-1.5 rounded-full <%= stage >= 2 ? 'bg-ok' : 'bg-line-2' %>"></span>
                    <span class="ml-0.5"><%= op.packedAt ? 'Packed' : op.pickedAt ? 'Picked' : 'To pick' %></span>
                  </div>
                <% } %>
              </td>
              <% if (isCount) { %>
                <td class="td whitespace-nowrap font-mono text-[0.8125rem]"><%= op.sourceLocation.fullName %><%= op.blindCount ? ' · blind' : '' %></td>
              <% } else if (type === 'internal') { %>
                <td class="td whitespace-nowrap font-mono text-[0.8125rem]"><%= op.sourceLocation.fullName %> <span class="text-muted">→</span> <%= op.destLocation.fullName %></td>
              <% } else { %>
                <td class="td font-medium"><%= op.partner || '—' %></td>
                <td class="td text-muted whitespace-nowrap font-mono text-[0.8125rem]"><%= type === 'receipt' ? op.destLocation.fullName : op.sourceLocation.fullName %></td>
              <% } %>
              <td class="td text-muted max-w-xs truncate" title="<%= productSummary(op) %>"><%= productSummary(op) %></td>
              <td class="td whitespace-nowrap <%= late ? 'text-bad font-semibold' : 'text-muted' %>">
                <%= fmtDate(op.scheduledDate) %>
                <% if (late) { %><span class="badge badge-bad ml-1">Late</span><% } %>
              </td>
              <td class="td"><span class="badge <%= STATUS_META[op.status].classes %>"><%= isCount && op.status === 'ready' ? 'Awaiting approval' : STATUS_META[op.status].label %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/pagination', { pagination, query, noun: meta.plural.toLowerCase() }) %>
  <% } %>
</div>

<%- include('../layout/app-bottom') %>
