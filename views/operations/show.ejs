<%- include('../layout/app-top') %>
<%
  const op = operation;
  const isOpen = ['draft', 'waiting', 'ready'].includes(op.status);
  const isDelivery = op.type === 'delivery';
  const isOutgoing = ['delivery', 'internal'].includes(op.type);
  const isCount = op.type === 'adjustment';
  const isManager = user.role === 'manager';
  const late = isLate(op);
  const canValidate = isOpen && (isCount ? isManager : !isDelivery || (op.status === 'ready' && op.packedAt));
  const canScan = isCount ? op.status === 'draft' : isDelivery ? op.status === 'ready' && !op.packedAt : isOpen;
  const hideRecorded = isCount && op.blindCount && !isManager && isOpen;
  const showProgress = !isCount && isOpen && op.lines.some((l) => l.scannedQty > 0 || canScan);

  // Progress stepper
  const flow = isDelivery ? ['draft', 'ready', 'picked', 'packed', 'done'] : ['draft', 'ready', 'done'];
  let currentStep = op.status;
  if (op.status === 'waiting') currentStep = 'ready';
  if (isDelivery && op.status === 'ready') currentStep = op.packedAt ? 'packed' : op.pickedAt ? 'picked' : 'ready';
  const currentIndex = flow.indexOf(currentStep);
  const stepLabel = (step) => ({
    draft: 'Draft',
    ready: op.status === 'waiting' ? 'Waiting' : isCount ? 'Submitted' : 'Ready',
    picked: 'Picked',
    packed: 'Packed',
    done: isCount ? 'Applied' : 'Done',
  }[step]);
  // Where the vehicle sits on the route (0 = at the start, 100 = arrived)
  const routePct = op.status === 'done' ? 100 : op.status === 'canceled' ? 0 : Math.round((Math.max(currentIndex, 0) / (flow.length - 1)) * 100);

  // Which action is the obvious next step
  let primary = null;
  if (op.status === 'draft' || op.status === 'waiting') primary = 'confirm';
  else if (op.status === 'ready') primary = isDelivery && !op.pickedAt ? 'pick' : isDelivery && !op.packedAt ? 'pack' : 'validate';
  const btn = (action) => 'btn ' + (primary === action ? 'btn-primary' : 'btn-secondary');
  const fromLabel = op.type === 'receipt' ? (op.partner || op.sourceLocation.fullName) : op.sourceLocation.fullName;
  const toLabel = op.type === 'delivery' ? (op.partner || op.destLocation.fullName) : op.destLocation.fullName;
  const fromIcon = op.type === 'receipt' ? 'deliveries' : 'warehouses';
  const toIcon = op.type === 'delivery' ? 'user' : 'warehouses';
  const vehicle = op.type === 'internal' ? 'transfers' : 'deliveries';

  // Count lines: recorded (open: live on-hand, applied: frozen), difference and value
  const countRows = isCount ? op.lines.map((l) => {
    const recorded = isOpen ? l.recorded : l.theoreticalQty;
    const diff = recorded === null || recorded === undefined ? null : Math.round((l.quantity - recorded) * 1000) / 1000;
    return { line: l, recorded, diff, value: diff === null ? null : diff * (l.product.unitCost || 0) };
  }) : [];
  const netValue = countRows.reduce((sum, r) => sum + (r.value || 0), 0);
  const totalQty = op.lines.reduce((sum, l) => sum + (l.quantity || 0), 0);
%>

<nav class="flex items-center gap-1.5 text-sm text-muted" aria-label="Breadcrumb">
  <a href="/<%= meta.slug %>" class="hover:text-ink"><%= isCount ? 'Stock counts' : meta.plural %></a>
  <%- icon('chevronRight', 'w-3.5 h-3.5') %> <span class="text-ink font-mono font-semibold"><%= op.reference %></span>
</nav>

<div data-live-region="operation" data-can-scan="<%= canScan %>" data-op-type="<%= op.type %>" data-op-status="<%= op.status %>" class="space-y-6 rounded-2xl">
  <div class="flex flex-col xl:flex-row xl:items-start justify-between gap-4">
    <div class="space-y-2">
      <p class="eyebrow"><%= isCount ? 'Stock count' : meta.label %></p>
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="page-title font-mono !tracking-tight"><%= op.reference %></h1>
        <span class="badge <%= STATUS_META[op.status].classes %>" data-status-badge><%= isCount && op.status === 'ready' ? 'Awaiting approval' : STATUS_META[op.status].label %></span>
        <% if (late) { %><span class="badge badge-bad">Late</span><% } %>
        <% if (isCount && op.blindCount) { %><span class="badge badge-neutral">Blind count</span><% } %>
      </div>
      <p class="text-sm text-muted"><%= isCount ? `Counting ${op.sourceLocation.fullName}` : `${fromLabel} → ${toLabel}` %> · <%= op.lines.length %> <%= op.lines.length === 1 ? 'product' : 'products' %></p>
    </div>

    <div class="flex flex-wrap gap-2" id="operationActions">
      <% if (op.status === 'draft') { %>
        <a href="/operations/<%= op._id %>/edit" class="btn btn-secondary"><%- icon('pencil', 'w-4 h-4') %> Edit</a>
        <button type="button" class="<%= btn('confirm') %>" data-op-action="confirm"><%= isCount ? 'Submit for approval' : 'Mark as To Do' %></button>
      <% } %>
      <% if (op.status === 'waiting') { %>
        <button type="button" class="<%= btn('confirm') %>" data-op-action="confirm">Check availability</button>
      <% } %>
      <% if (isDelivery && op.status === 'ready' && !op.pickedAt) { %>
        <button type="button" class="<%= btn('pick') %>" data-op-action="pick"><%- icon('scan', 'w-4 h-4') %> Mark as picked</button>
      <% } %>
      <% if (isDelivery && op.status === 'ready' && op.pickedAt && !op.packedAt) { %>
        <button type="button" class="<%= btn('pack') %>" data-op-action="pack"><%- icon('box', 'w-4 h-4') %> Mark as packed</button>
      <% } %>
      <% if (canValidate) { %>
        <button type="button" class="<%= primary === 'validate' || isCount ? 'btn btn-success' : 'btn btn-secondary' %>" data-op-action="validate" data-magnetic><%- icon('check', 'w-4 h-4') %> <%= isCount ? 'Apply count' : 'Validate' %></button>
      <% } %>
      <% if (['waiting', 'ready'].includes(op.status)) { %>
        <button type="button" class="btn btn-secondary" data-op-action="reset" title="Back to draft to edit it">Back to draft</button>
      <% } %>
      <% if (isOpen) { %>
        <button type="button" class="btn btn-danger" data-op-action="cancel">Cancel</button>
      <% } %>
      <% if (!isCount) { %>
        <button type="button" class="btn btn-ghost" data-op-action="duplicate" title="Create a new draft with the same products"><%- icon('copy', 'w-4 h-4') %> Duplicate</button>
      <% } %>
      <a href="/operations/<%= op._id %>/print" target="_blank" rel="noopener" class="btn btn-ghost"><%- icon('printer', 'w-4 h-4') %> Print</a>
    </div>
  </div>

  <% if (isCount && op.status === 'ready' && !isManager) { %>
    <div class="rounded-2xl border border-info/30 bg-info-soft p-4 text-sm font-medium text-info flex items-center gap-3"><%- icon('info', 'w-5 h-5 shrink-0') %> Submitted. An Inventory Manager will review the differences and apply the count.</div>
  <% } %>

  <!-- Route + progress -->
  <% if (op.status === 'canceled') { %>
    <div class="relative overflow-hidden rounded-2xl border border-bad/30 bg-bad-soft p-4 pl-5 text-sm text-ink-2 flex items-center gap-3">
      <span class="absolute left-0 inset-y-0 w-1.5 bg-bad" aria-hidden="true"></span>
      <%- icon('x', 'w-5 h-5 shrink-0 text-bad') %>
      <p>Canceled on <strong class="text-ink"><%= fmtDateTime(op.canceledAt) %></strong>. No stock was changed.<% if (!isCount) { %> Use <strong class="text-ink">Duplicate</strong> to start again.<% } %></p>
    </div>
  <% } else { %>
    <section class="card overflow-hidden" id="routeCard" data-op-scene aria-label="Progress">
      <% if (!isCount) { %>
        <div class="floor px-5 sm:px-6 py-5 grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-3 sm:gap-5">
          <div class="flex items-center gap-3 min-w-0">
            <span class="tile w-11 h-11 rounded-xl bg-surface border border-line shadow-card"><%- icon(fromIcon, 'w-5 h-5') %></span>
            <div class="hidden sm:block min-w-0">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-muted">From</p>
              <p class="text-sm font-semibold truncate max-w-[12rem]"><%= fromLabel %></p>
            </div>
          </div>
          <div class="relative h-12" data-route-track>
            <span class="absolute inset-x-0 top-1/2 -translate-y-1/2 route-line" aria-hidden="true"></span>
            <span class="absolute left-0 top-1/2 -translate-y-1/2 h-[2px] rounded-full bg-ok transition-[width] duration-700 ease-out-soft" style="width: <%= routePct %>%" data-route-fill aria-hidden="true"></span>
            <span class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 flex items-center justify-center w-10 h-10 rounded-xl <%= op.status === 'done' ? 'bg-ok text-canvas' : 'bg-accent text-accent-ink' %> shadow-float transition-[left] duration-700 ease-out-soft" style="left: <%= Math.min(Math.max(routePct, 6), 94) %>%" data-route-vehicle aria-hidden="true">
              <%- icon(op.status === 'done' ? 'check' : vehicle, 'w-5 h-5') %>
            </span>
          </div>
          <div class="flex items-center justify-end gap-3 min-w-0">
            <div class="hidden sm:block min-w-0 text-right">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-muted">To</p>
              <p class="text-sm font-semibold truncate max-w-[12rem]"><%= toLabel %></p>
            </div>
            <span class="tile w-11 h-11 rounded-xl bg-surface border border-line shadow-card"><%- icon(toIcon, 'w-5 h-5') %></span>
          </div>
        </div>
      <% } %>
      <ol class="flex items-center gap-2 overflow-x-auto scrollbar-none px-5 sm:px-6 py-3.5 <%= isCount ? '' : 'border-t border-line' %>" aria-label="Steps">
        <% flow.forEach((step, i) => {
             const state = i < currentIndex || op.status === 'done' ? 'done' : i === currentIndex ? 'current' : 'upcoming';
             const waiting = step === 'ready' && op.status === 'waiting'; %>
          <li class="route-step shrink-0" data-state="<%= state %>" data-step="<%= step %>" <%- state === 'current' ? 'aria-current="step"' : '' %>>
            <span class="route-dot <%= waiting && state === 'current' ? '!border-warn !bg-warn-soft !text-warn' : '' %>"><%- state === 'done' ? icon('check', 'w-3.5 h-3.5') : i + 1 %></span>
            <%= stepLabel(step) %>
          </li>
          <% if (i < flow.length - 1) { %><li class="route-line" data-state="<%= i < currentIndex || op.status === 'done' ? 'done' : '' %>" aria-hidden="true"></li><% } %>
        <% }) %>
      </ol>
    </section>
  <% } %>

  <!-- Shortages -->
  <% if (isOpen && isOutgoing && shortages.length > 0) { %>
    <div class="relative overflow-hidden rounded-2xl border border-warn/30 bg-warn-soft p-4 pl-5 space-y-3" role="status">
      <span class="absolute left-0 inset-y-0 w-1.5 hazard" aria-hidden="true"></span>
      <div class="flex items-start gap-3 text-sm text-ink-2">
        <%- icon('warning', 'w-5 h-5 shrink-0 text-warn') %>
        <p>Not enough stock in <strong class="text-ink"><%= op.sourceLocation.fullName %></strong> to process this <%= meta.label.toLowerCase() %>. It can be validated once stock arrives.</p>
      </div>
      <ul class="space-y-2 pl-8">
        <% shortages.forEach((s) => { const missing = Math.round((s.required - s.available) * 1000) / 1000; %>
          <li class="flex flex-wrap items-center gap-3 text-sm text-ink-2">
            <span><strong class="text-ink"><%= s.name %></strong> <span class="sku"><%= s.sku %></span> need <%= fmtQty(s.required) %>, have <%= fmtQty(s.available) %> - short <strong class="text-bad"><%= fmtQty(missing) %></strong></span>
            <a href="/receipts/new?product=<%= s.product %>&qty=<%= missing %>" class="btn btn-secondary btn-sm">Create receipt</a>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <div class="grid lg:grid-cols-3 gap-6">
    <!-- Details -->
    <section class="card lg:col-span-1" aria-labelledby="detailsTitle">
      <div class="panel-head"><h2 id="detailsTitle" class="panel-title">Details</h2></div>
      <dl class="p-5 space-y-3.5 text-sm">
        <% if (!isCount && (op.type !== 'internal' || op.partner)) { %>
          <div><dt class="text-xs text-muted"><%= meta.partnerLabel %></dt><dd class="font-semibold"><%= op.partner || '—' %></dd></div>
        <% } %>
        <% if (isCount) { %>
          <div><dt class="text-xs text-muted">Location counted</dt><dd><a href="/locations/<%= op.sourceLocation._id %>" class="font-mono font-semibold hover:text-accent-text"><%= op.sourceLocation.fullName %></a></dd></div>
        <% } else { %>
          <div class="grid grid-cols-2 gap-3">
            <div><dt class="text-xs text-muted">From</dt><dd class="font-mono text-[0.8125rem] font-semibold"><%= op.sourceLocation.fullName %></dd></div>
            <div><dt class="text-xs text-muted">To</dt><dd class="font-mono text-[0.8125rem] font-semibold"><%= op.destLocation.fullName %></dd></div>
          </div>
        <% } %>
        <div><dt class="text-xs text-muted">Warehouse</dt><dd><%= op.warehouse ? op.warehouse.name : '—' %></dd></div>
        <div><dt class="text-xs text-muted"><%= isCount ? 'Count date' : 'Scheduled' %></dt><dd class="<%= late ? 'text-bad font-semibold' : '' %>"><%= fmtDate(op.scheduledDate) %> <span class="text-muted font-normal">· <%= fmtRelativeDays(op.scheduledDate) %></span></dd></div>
        <div class="pt-3.5 border-t border-line">
          <dt class="text-xs text-muted mb-2">History</dt>
          <dd>
            <ol class="space-y-2.5">
              <li class="flex gap-2.5"><span class="mt-1.5 w-2 h-2 rounded-full bg-line-2 shrink-0"></span><span>Created <span class="text-muted"><%= fmtDateTime(op.createdAt) %><%= op.createdBy ? ' by ' + op.createdBy.name : '' %></span></span></li>
              <% if (op.pickedAt) { %><li class="flex gap-2.5"><span class="mt-1.5 w-2 h-2 rounded-full bg-accent shrink-0"></span><span>Picked <span class="text-muted"><%= fmtDateTime(op.pickedAt) %><%= op.pickedBy ? ' by ' + op.pickedBy.name : '' %></span></span></li><% } %>
              <% if (op.packedAt) { %><li class="flex gap-2.5"><span class="mt-1.5 w-2 h-2 rounded-full bg-accent shrink-0"></span><span>Packed <span class="text-muted"><%= fmtDateTime(op.packedAt) %><%= op.packedBy ? ' by ' + op.packedBy.name : '' %></span></span></li><% } %>
              <% if (op.validatedAt) { %><li class="flex gap-2.5"><span class="mt-1.5 w-2 h-2 rounded-full bg-ok shrink-0"></span><span class="font-medium text-ok"><%= isCount ? 'Applied' : 'Validated' %> <span class="font-normal text-muted"><%= fmtDateTime(op.validatedAt) %><%= op.validatedBy ? ' by ' + op.validatedBy.name : '' %></span></span></li><% } %>
            </ol>
          </dd>
        </div>
        <% if (op.notes) { %><div class="pt-3.5 border-t border-line"><dt class="text-xs text-muted">Notes</dt><dd class="whitespace-pre-line text-ink-2"><%= op.notes %></dd></div><% } %>
      </dl>
    </section>

    <!-- Lines -->
    <section class="card overflow-hidden lg:col-span-2" aria-labelledby="linesTitle">
      <div class="panel-head">
        <h2 id="linesTitle" class="panel-title"><%= isCount ? 'Count sheet' : 'Products' %></h2>
        <% if (!isCount) { %><span class="text-xs text-muted"><span class="font-mono font-semibold text-ink"><%= fmtQty(totalQty) %></span> units in total</span><% } %>
      </div>
      <div class="overflow-x-auto">
        <% if (isCount) { %>
          <table class="table">
            <thead>
              <tr>
                <th class="th">Product</th>
                <% if (!hideRecorded) { %><th class="th text-right"><%= isOpen ? 'Recorded' : 'Recorded before' %></th><% } %>
                <th class="th text-right">Counted</th>
                <% if (!hideRecorded) { %><th class="th text-right">Difference</th><th class="th text-right">Value</th><% } %>
                <th class="th">Reason</th>
              </tr>
            </thead>
            <tbody>
              <% countRows.forEach(({ line, recorded, diff, value }) => { const p = line.product; const tone = diff > 0 ? 'text-ok' : diff < 0 ? 'text-bad' : 'text-muted'; %>
                <tr>
                  <td class="td"><a href="/products/<%= p._id %>" class="font-semibold hover:text-accent-text"><%= p.name %></a><div class="mt-1"><span class="sku"><%= p.sku %></span></div></td>
                  <% if (!hideRecorded) { %><td class="td text-right font-mono tabular text-muted"><%= recorded === null || recorded === undefined ? '—' : fmtQty(recorded) %></td><% } %>
                  <td class="td text-right font-mono tabular font-semibold"><%= fmtQty(line.quantity) %> <span class="font-sans text-xs font-normal text-muted"><%= p.uom %></span><% if (line.scannedQty) { %><div class="font-sans text-[11px] font-normal text-muted"><%= fmtQty(line.scannedQty) %> by scan</div><% } %></td>
                  <% if (!hideRecorded) { %>
                    <td class="td text-right font-mono tabular font-semibold <%= tone %>"><%= diff === null ? '—' : diff === 0 ? '0' : (diff > 0 ? '+' : '') + fmtQty(diff) %></td>
                    <td class="td text-right font-mono tabular whitespace-nowrap <%= tone %>"><%= value ? fmtMoney(value) : '—' %></td>
                  <% } %>
                  <td class="td text-ink-2"><%= REASON_META[line.reason || 'count'] %></td>
                </tr>
              <% }) %>
            </tbody>
            <% if (!hideRecorded) { %>
              <tfoot><tr><td class="td text-right text-muted border-t border-line-2" colspan="4">Net difference value</td><td class="td text-right font-mono font-semibold tabular border-t border-line-2 <%= netValue < 0 ? 'text-bad' : netValue > 0 ? 'text-ok' : '' %>"><%= fmtMoney(netValue) %></td><td class="td border-t border-line-2"></td></tr></tfoot>
            <% } %>
          </table>
        <% } else { %>
          <table class="table">
            <thead>
              <tr>
                <th class="th">Product</th>
                <th class="th text-right">Quantity</th>
                <% if (showProgress) { %><th class="th w-48"><%= op.type === 'receipt' ? 'Checked in' : 'Picked' %></th><% } %>
                <% if (isOpen && isOutgoing) { %><th class="th text-right">Available at source</th><% } %>
              </tr>
            </thead>
            <tbody>
              <% op.lines.forEach((line) => { const p = line.product; const short = isOpen && isOutgoing && line.available < line.quantity; const pct = Math.min(100, Math.round(((line.scannedQty || 0) / line.quantity) * 100)); %>
                <tr data-line-product="<%= p._id %>">
                  <td class="td">
                    <a href="/products/<%= p._id %>" class="font-semibold hover:text-accent-text"><%= p.name %></a>
                    <div class="mt-1"><span class="sku"><%= p.sku %></span></div>
                  </td>
                  <td class="td text-right font-mono tabular font-semibold"><%= fmtQty(line.quantity) %> <span class="font-sans text-xs font-normal text-muted"><%= p.uom %></span></td>
                  <% if (showProgress) { %>
                    <td class="td">
                      <div class="flex items-center gap-2">
                        <div class="flex-1 h-2 rounded-full bg-sunken overflow-hidden"><div class="h-full rounded-full <%= pct >= 100 ? 'bg-ok' : 'bg-accent' %> transition-all duration-500" style="width: <%= pct %>%"></div></div>
                        <span class="font-mono text-xs tabular <%= pct >= 100 ? 'text-ok font-semibold' : 'text-muted' %>"><%= fmtQty(line.scannedQty || 0) %>/<%= fmtQty(line.quantity) %></span>
                      </div>
                    </td>
                  <% } %>
                  <% if (isOpen && isOutgoing) { %>
                    <td class="td text-right font-mono tabular <%= short ? 'text-bad font-semibold' : 'text-ok' %>"><%= fmtQty(line.available) %> <span class="font-sans text-xs"><%= p.uom %></span><%= short ? ' ⚠' : '' %></td>
                  <% } %>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </section>
  </div>

  <% if (moves.length > 0) { %>
    <section class="card overflow-hidden" aria-labelledby="ledgerTitle">
      <div class="panel-head">
        <h2 id="ledgerTitle" class="panel-title">Stock moves (ledger)</h2>
        <span class="badge badge-ok"><%= moves.length %> posted</span>
      </div>
      <div class="overflow-x-auto">
        <table class="table">
          <thead><tr><th class="th">Product</th><th class="th">From</th><th class="th">To</th><th class="th text-right">Quantity</th><th class="th">Date</th></tr></thead>
          <tbody>
            <% moves.forEach((m) => { %>
              <tr>
                <td class="td font-medium"><%= m.product ? m.product.name : '—' %></td>
                <td class="td font-mono text-[0.8125rem] text-ink-2"><%= m.fromLocation.fullName %></td>
                <td class="td font-mono text-[0.8125rem] text-ink-2"><%= m.toLocation.fullName %></td>
                <td class="td text-right font-mono tabular font-semibold"><%= fmtQty(m.quantity) %> <span class="font-sans text-xs font-normal text-muted"><%= m.product ? m.product.uom : '' %></span></td>
                <td class="td text-muted whitespace-nowrap"><%= fmtDateTime(m.date) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  <% } %>
</div>

<!-- Who else is here (Live Warehouse presence) -->
<div id="presence" class="hidden flex flex-wrap items-center gap-2" aria-live="polite"></div>

<!-- Scan & Pick (outside the live region so typing is never interrupted) -->
<section id="scanPanel" class="card overflow-hidden <%= canScan ? '' : 'hidden' %>" aria-label="Scan">
  <div class="panel-head flex-wrap">
    <div>
      <h2 class="panel-title flex items-center gap-2"><span class="tile w-7 h-7 rounded-lg bg-accent text-accent-ink"><%- icon('scan', 'w-4 h-4') %></span> <%= isCount ? 'Scan to count' : isDelivery ? 'Scan to pick' : 'Scan to check' %></h2>
      <p class="mt-1 text-xs text-muted">USB scanner, phone/laptop camera, or type a SKU and press Enter. Scan a location label to confirm you're at the right bin.</p>
    </div>
    <button type="button" id="cameraToggle" class="btn btn-secondary btn-sm"><%- icon('scan', 'w-4 h-4') %> Use camera</button>
  </div>
  <div class="p-5 space-y-4">
    <form id="scanForm" class="scan-bar flex flex-col sm:flex-row gap-2" autocomplete="off">
      <div class="relative flex-1">
        <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted"><%- icon('scan', 'w-5 h-5') %></span>
        <input id="scanInput" class="input h-12 pl-11 font-mono text-base" placeholder="Scan barcode or type SKU / location" aria-label="Barcode">
        <span class="scan-laser" aria-hidden="true"></span>
      </div>
      <input id="scanQty" type="number" min="0" step="any" value="1" class="input h-12 sm:w-24 font-mono text-center tabular" aria-label="Quantity per scan" title="Quantity per scan">
      <button type="submit" class="btn btn-primary h-12 px-6">Scan</button>
    </form>
    <div id="scanCamera" class="hidden rounded-xl overflow-hidden border border-line max-w-md"></div>
    <ul id="scanLog" class="space-y-1.5 text-sm" aria-live="polite"></ul>
  </div>
</section>

<script src="/js/scan.js"></script>
<script>
  (() => {
    const { api, toast, toastAfterNavigation, confirmDialog, setBusy } = window.StockSense;
    const id = '<%= op._id %>';
    const reference = '<%= op.reference %>';
    const opType = '<%= op.type %>';

    const confirmations = {
      validate: {
        title: <%- jsonForScript(isCount ? 'Apply ' + op.reference + '?' : 'Validate ' + op.reference + '?') %>,
        message: <%- jsonForScript((op.type === 'receipt' ? 'Stock will be added to the destination location.' : op.type === 'delivery' ? 'Stock will be removed from the source location.' : isCount ? 'Recorded stock will be set to the counted quantities.' : 'Stock will move between the two locations.') + ' This cannot be undone.') %>,
        confirmLabel: <%- jsonForScript(isCount ? 'Apply count' : 'Validate') %>,
        tone: 'success',
        summary: <%- jsonForScript(isCount
          ? [{ label: 'Location', value: op.sourceLocation.fullName }, { label: 'Products counted', value: String(op.lines.length) }, ...(hideRecorded ? [] : [{ label: 'Net difference value', value: fmtMoney(netValue) }])]
          : [{ label: 'From', value: op.sourceLocation.fullName }, { label: 'To', value: op.destLocation.fullName }, { label: 'Products', value: `${op.lines.length} (${fmtQty(totalQty)} units)` }]) %>,
      },
      cancel: {
        title: `Cancel ${reference}?`,
        message: 'The operation will be closed without changing any stock.',
        confirmLabel: 'Cancel operation',
        danger: true,
      },
    };

    // Delegated at document level: the live region re-renders these buttons
    document.addEventListener('click', async (e) => {
      const button = e.target.closest('[data-op-action]');
      if (!button) return;
      const action = button.dataset.opAction;
      if (confirmations[action] && !(await confirmDialog(confirmations[action]))) return;

      setBusy(button, true);
      try {
        const res = await api('POST', `/api/operations/${id}/${action}`);
        const target = action === 'duplicate' ? `/operations/${res.data.operation._id}` : window.location.pathname;
        const tone = action === 'confirm' && res.data.operation.status === 'waiting' ? 'info' : 'success';
        toastAfterNavigation(res.message, tone);
        // Play the matching scene (truck, tape, stamp...) before the page moves on
        if (window.StockSense.scenes) await window.StockSense.scenes.play({ action, type: opType, operation: res.data.operation });
        window.location.href = target;
      } catch (err) {
        if (action === 'validate' && err.details && err.details.shortages) {
          toastAfterNavigation(err.message, 'error');
          window.location.reload();
          return;
        }
        toast(err.message, 'error', 8000);
        setBusy(button, false);
      }
    });

    // Scan & Pick
    const scanPanel = document.getElementById('scanPanel');
    const scanner = window.StockSenseScanner.attach({
      form: document.getElementById('scanForm'),
      input: document.getElementById('scanInput'),
      quantity: document.getElementById('scanQty'),
      log: document.getElementById('scanLog'),
      cameraButton: document.getElementById('cameraToggle'),
      cameraBox: document.getElementById('scanCamera'),
      onCode: async (code, quantity) => {
        const res = await api('POST', `/api/operations/${id}/scan`, { code, quantity });
        // (the live stream also refreshes the page; this makes our own scans instant)
        if (window.StockSense.live) window.StockSense.live.refreshRegions();
        return { ok: true, message: res.message, done: res.data.complete };
      },
    });

    // Hide the scanner when someone else moves the operation on
    document.addEventListener('stocksense:regions-updated', () => {
      const region = document.querySelector('[data-can-scan]');
      const can = region && region.dataset.canScan === 'true';
      scanPanel.classList.toggle('hidden', !can);
      if (!can) scanner.stopCamera();
    });
  })();
</script>

<%- include('../layout/app-bottom') %>
