<%- include('../layout/app-top') %>
<% const isManager = user.role === 'manager'; %>

<header class="flex flex-col sm:flex-row sm:items-end justify-between gap-4" data-reveal>
  <div>
    <p class="eyebrow">Settings</p>
    <h1 class="page-title mt-1">Warehouses &amp; locations</h1>
    <p class="text-sm text-muted mt-1.5 max-w-2xl">Each warehouse has locations (racks, bins, zones) that hold stock. The warehouse code prefixes every document, e.g. <span class="sku">WH/IN/0001</span>.</p>
  </div>
</header>

<% if (isManager) { %>
  <form id="newWarehouse" class="card p-3 grid md:grid-cols-[1.2fr_0.6fr_1.4fr_auto] gap-2" novalidate aria-label="New warehouse" data-reveal>
    <input name="name" class="input" placeholder="Warehouse name" maxlength="80" required aria-label="Warehouse name">
    <input name="code" class="input font-mono uppercase" placeholder="Code, e.g. WH3" maxlength="5" required aria-label="Warehouse code">
    <input name="address" class="input" placeholder="Address (optional)" maxlength="200" aria-label="Address">
    <button type="submit" class="btn btn-accent"><%- icon('plus', 'w-4 h-4') %> Add warehouse</button>
  </form>
<% } %>

<div class="grid xl:grid-cols-2 gap-6">
  <% warehouses.forEach((w) => { const active = w.locations.filter((l) => l.isActive); %>
    <section class="card overflow-hidden" data-warehouse="<%= w._id %>" data-reveal>
      <div class="flex flex-wrap items-start justify-between gap-3 px-5 py-4 border-b border-line">
        <div class="flex items-center gap-3">
          <span class="tile w-11 h-11 rounded-xl bg-ink text-canvas"><%- icon('warehouses', 'w-5 h-5') %></span>
          <div>
            <h2 class="text-lg font-bold leading-tight"><%= w.name %> <span class="ml-1 sku align-middle"><%= w.code %></span></h2>
            <p class="text-xs text-muted mt-0.5"><%= w.address || 'No address' %> · <%= active.length %> locations · <span class="font-mono font-semibold text-ink"><%= fmtMoney(w.value) %></span> in stock</p>
          </div>
        </div>
        <a href="/labels?warehouse=<%= w._id %>" target="_blank" rel="noopener" class="btn btn-secondary btn-sm"><%- icon('printer', 'w-4 h-4') %> Bin labels</a>
      </div>

      <!-- Floor plan -->
      <div class="floor border-b border-line px-4 pt-4 pb-2">
        <%- include('../partials/iso-floor', { w }) %>
        <div class="flex items-center justify-between gap-3 pt-2 text-[0.7rem] text-muted">
          <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-accent"></span> Taller stack = more stock value</span>
          <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm border border-line-2 bg-surface"></span> Empty</span>
        </div>
      </div>

      <table class="table table-hover">
        <thead><tr><th class="th">Location</th><th class="th text-right">Products</th><th class="th text-right">Value</th><% if (isManager) { %><th class="th"><span class="sr-only">Actions</span></th><% } %></tr></thead>
        <tbody>
          <% w.locations.forEach((l) => { %>
            <tr class="<%= l.isActive ? '' : 'opacity-50' %>" data-location="<%= l._id %>">
              <td class="td">
                <a href="/locations/<%= l._id %>" class="font-mono text-[0.8125rem] font-semibold hover:text-accent-text" data-view><%= l.fullName %></a>
                <% if (!l.isActive) { %><span class="badge badge-neutral ml-1">Archived</span><% } %>
                <input data-edit class="input input-sm hidden" value="<%= l.name %>" maxlength="60" aria-label="Location name">
              </td>
              <td class="td text-right font-mono tabular"><%= l.products %></td>
              <td class="td text-right font-mono tabular text-muted"><%= l.value ? fmtMoney(l.value) : '—' %></td>
              <% if (isManager) { %>
                <td class="td text-right whitespace-nowrap">
                  <span data-view>
                    <button type="button" class="btn btn-secondary btn-sm" data-action="rename">Rename</button>
                    <% if (l.isActive) { %><button type="button" class="btn btn-danger btn-sm" data-action="archive">Archive</button>
                    <% } else { %><button type="button" class="btn btn-success btn-sm" data-action="restore">Restore</button><% } %>
                  </span>
                  <span data-edit class="hidden">
                    <button type="button" class="btn btn-primary btn-sm" data-action="save">Save</button>
                    <button type="button" class="btn btn-secondary btn-sm" data-action="cancel">Cancel</button>
                  </span>
                </td>
              <% } %>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (isManager) { %>
        <form class="flex gap-2 px-4 py-3 border-t border-line bg-surface-2" data-new-location novalidate>
          <input name="name" class="input input-sm" placeholder="New location, e.g. Rack C" maxlength="60" aria-label="New location name">
          <button type="submit" class="btn btn-secondary btn-sm h-9"><%- icon('plus', 'w-4 h-4') %> Add</button>
        </form>
      <% } %>
    </section>
  <% }) %>
</div>

<% if (isManager) { %>
<script>
  (() => {
    const { api, toast, toastAfterNavigation, setBusy } = window.StockSense;
    const reloadWith = (message) => {
      toastAfterNavigation(message);
      window.location.reload();
    };

    document.getElementById('newWarehouse').addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(e.target).entries());
      if (!data.name.trim() || !data.code.trim()) return toast('Name and code are required', 'error');
      const button = e.target.querySelector('button');
      setBusy(button, true, 'Adding...');
      try {
        reloadWith((await api('POST', '/api/warehouses', data)).message);
      } catch (err) {
        toast(err.message, 'error');
        setBusy(button, false);
      }
    });

    document.querySelectorAll('[data-new-location]').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = form.querySelector('input[name=name]').value.trim(); // (form.name is the form's own attribute)
        if (!name) return toast('Enter a location name', 'error');
        const warehouse = form.closest('[data-warehouse]').dataset.warehouse;
        try {
          reloadWith((await api('POST', '/api/locations', { warehouse, name })).message);
        } catch (err) {
          toast(err.message, 'error');
        }
      });
    });

    document.querySelectorAll('[data-location]').forEach((row) => {
      const id = row.dataset.location;
      const toggle = (editing) => {
        row.querySelectorAll('[data-view]').forEach((el) => el.classList.toggle('hidden', editing));
        row.querySelectorAll('[data-edit]').forEach((el) => el.classList.toggle('hidden', !editing));
      };
      row.addEventListener('click', async (e) => {
        const button = e.target.closest('[data-action]');
        if (!button) return;
        const action = button.dataset.action;
        if (action === 'rename') return toggle(true);
        if (action === 'cancel') return toggle(false);
        try {
          if (action === 'save') {
            reloadWith((await api('PATCH', `/api/locations/${id}`, { name: row.querySelector('input[data-edit]').value })).message);
          } else {
            reloadWith((await api('POST', `/api/locations/${id}/${action}`)).message);
          }
        } catch (err) {
          toast(err.message, 'error', 7000);
        }
      });
    });
  })();
</script>
<% } %>

<%- include('../layout/app-bottom') %>
