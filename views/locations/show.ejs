<%- include('../layout/app-top') %>
<% const maxQty = Math.max(1, ...stock.map((q) => q.quantity)); %>

<nav class="flex items-center gap-1.5 text-sm text-muted" aria-label="Breadcrumb">
  <a href="/settings/warehouses" class="hover:text-ink">Warehouses</a> <%- icon('chevronRight', 'w-3.5 h-3.5') %> <span class="text-ink font-mono font-semibold"><%= location.fullName %></span>
</nav>

<header class="flex flex-col sm:flex-row sm:items-end justify-between gap-4" data-reveal>
  <div class="flex items-center gap-4">
    <span class="tile w-12 h-12 rounded-2xl bg-accent text-accent-ink shadow-card"><%- icon('map', 'w-6 h-6') %></span>
    <div>
      <p class="eyebrow"><%= location.warehouse ? location.warehouse.name : 'Location' %></p>
      <h1 class="page-title font-mono !tracking-tight mt-0.5"><%= location.fullName %></h1>
      <p class="text-sm text-muted mt-1"><%= stock.length %> product<%= stock.length === 1 ? '' : 's' %> · <span class="font-mono font-semibold text-ink"><%= fmtMoney(value) %></span><% if (!location.isActive) { %> · <span class="font-semibold text-warn">archived</span><% } %></p>
    </div>
  </div>
  <div class="flex flex-wrap gap-2">
    <a href="/adjustments/new?location=<%= location._id %>" class="btn btn-accent"><%- icon('adjustments', 'w-4 h-4') %> Count this location</a>
    <a href="/moves?location=<%= location._id %>" class="btn btn-secondary"><%- icon('history', 'w-4 h-4') %> Moves</a>
    <a href="/labels?location=<%= location._id %>" target="_blank" rel="noopener" class="btn btn-secondary"><%- icon('printer', 'w-4 h-4') %> Label</a>
  </div>
</header>

<div class="card overflow-hidden" data-live-region="bin" data-reveal>
  <% if (stock.length === 0) { %>
    <%- include('../partials/empty', { art: 'bins', title: 'This location is empty', text: 'Receive or transfer stock here and it shows up instantly.' }) %>
  <% } else { %>
    <table class="table table-hover">
      <thead><tr><th class="th">Product</th><th class="th">Share of this bin</th><th class="th text-right">Quantity</th><th class="th text-right">Value</th></tr></thead>
      <tbody>
        <% stock.forEach((q) => { const p = q.product; %>
          <tr>
            <td class="td"><a href="/products/<%= p._id %>" class="font-semibold hover:text-accent-text"><%= p.name %></a><div class="mt-1"><span class="sku"><%= p.sku %></span></div></td>
            <td class="td w-1/3"><span class="block h-2 rounded-full bg-sunken overflow-hidden"><span class="block h-full rounded-full bg-accent" style="width: <%= ((q.quantity / maxQty) * 100).toFixed(1) %>%"></span></span></td>
            <td class="td text-right font-mono tabular font-semibold"><%= fmtQty(q.quantity) %> <span class="font-sans text-xs font-normal text-muted"><%= p.uom %></span></td>
            <td class="td text-right font-mono tabular text-muted"><%= p.unitCost ? fmtMoney(q.quantity * p.unitCost) : '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../layout/app-bottom') %>
