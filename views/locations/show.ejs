<%- include('../layout/app-top') %>

<nav class="text-sm text-slate-500" aria-label="Breadcrumb">
  <a href="/settings/warehouses" class="hover:text-slate-300">Warehouses</a> <span class="mx-1">/</span> <span class="text-slate-300"><%= location.fullName %></span>
</nav>

<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold text-white tracking-tight"><%= location.fullName %></h1>
    <p class="text-sm text-slate-400 mt-1"><%= location.warehouse ? location.warehouse.name : '' %> · <%= stock.length %> product(s) · <%= fmtMoney(value) %><% if (!location.isActive) { %> · <span class="text-amber-400">archived</span><% } %></p>
  </div>
  <div class="flex flex-wrap gap-2">
    <a href="/adjustments/new?location=<%= location._id %>" class="btn btn-primary"><%- icon('adjustments', 'w-4 h-4') %> Count this location</a>
    <a href="/moves?location=<%= location._id %>" class="btn btn-secondary"><%- icon('history', 'w-4 h-4') %> Moves</a>
    <a href="/labels?location=<%= location._id %>" target="_blank" rel="noopener" class="btn btn-secondary"><%- icon('printer', 'w-4 h-4') %> Label</a>
  </div>
</div>

<div class="card overflow-hidden" data-live-region="bin">
  <% if (stock.length === 0) { %>
    <p class="p-12 text-center text-slate-400">This location is empty.</p>
  <% } else { %>
    <table class="min-w-full">
      <thead class="bg-slate-900/80"><tr><th class="th">Product</th><th class="th text-right">Quantity</th><th class="th text-right">Value</th></tr></thead>
      <tbody>
        <% stock.forEach((q) => { const p = q.product; %>
          <tr class="border-t border-slate-800">
            <td class="td"><a href="/products/<%= p._id %>" class="font-medium text-white hover:text-blue-300"><%= p.name %></a><div class="text-xs font-mono text-slate-500"><%= p.sku %></div></td>
            <td class="td text-right tabular-nums font-semibold"><%= fmtQty(q.quantity) %> <span class="text-xs font-normal text-slate-500"><%= p.uom %></span></td>
            <td class="td text-right tabular-nums text-slate-400"><%= p.unitCost ? fmtMoney(q.quantity * p.unitCost) : '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../layout/app-bottom') %>
