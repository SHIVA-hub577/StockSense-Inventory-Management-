<%- include('layout/header') %>

<div class="min-h-full flex flex-col justify-between">
  <!-- Navigation Bar -->
  <nav class="border-b border-slate-800/80 bg-slate-950/70 backdrop-blur-md sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center text-white font-bold text-lg shadow-lg shadow-blue-500/30">
          SS
        </div>
        <span class="text-xl font-extrabold text-white tracking-tight">StockSense</span>
      </div>

      <div class="flex items-center space-x-4">
        <a 
          href="/auth/login" 
          class="px-5 py-2.5 rounded-xl text-sm font-semibold text-slate-300 hover:text-white hover:bg-slate-800/60 transition-all border border-transparent hover:border-slate-700"
        >
          Sign In
        </a>
        <a 
          href="/auth/signup" 
          class="px-5 py-2.5 rounded-xl text-sm font-semibold bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-lg shadow-blue-600/25 hover:from-blue-500 hover:to-indigo-500 transition-all"
        >
          Register Now
        </a>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="py-20 lg:py-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto text-center space-y-8 relative overflow-hidden">
    <!-- Glowing background accent -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-blue-600/15 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full text-xs font-semibold bg-blue-500/10 text-blue-400 border border-blue-500/20 shadow-inner">
      <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
      <span>Next-Gen Inventory & Warehouse Control Platform</span>
    </div>

    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-white tracking-tight max-w-4xl mx-auto leading-tight sm:leading-tight">
      Eliminate Inventory Chaos. <br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-purple-400">
        Empower Your Team.
      </span>
    </h1>

    <p class="text-base sm:text-xl text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed">
      StockSense bridges the gap between high-level inventory managers and hands-on warehouse staff with real-time tracking, role-based workflows, and automated security.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
      <a 
        href="/auth/signup" 
        class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-bold text-base shadow-xl shadow-blue-600/30 hover:from-blue-500 hover:to-indigo-500 transition-all flex items-center justify-center group"
      >
        <span>Get Started — It's Free</span>
        <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
      <a 
        href="/auth/login" 
        class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900/90 text-slate-200 hover:text-white font-bold text-base border border-slate-700 hover:border-slate-500 transition-all flex items-center justify-center"
      >
        Sign In to Account
      </a>
    </div>
  </section>

  <!-- Problems Solved Section -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full space-y-12">
    <div class="text-center space-y-3">
      <h2 class="text-xs font-bold tracking-widest text-blue-400 uppercase">Why StockSense?</h2>
      <p class="text-3xl font-extrabold text-white tracking-tight sm:text-4xl">Common Inventory Pitfalls We Solve</p>
      <p class="text-sm text-slate-400 max-w-xl mx-auto">Traditional inventory spreadsheets lead to stockouts, misplaced orders, and unauthorized changes. StockSense replaces confusion with clarity.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

      <!-- Feature Card 1 -->
      <div class="glass-card rounded-2xl p-8 space-y-4 border border-slate-800/80 hover:border-blue-500/40 transition-all">
        <div class="w-12 h-12 rounded-xl bg-rose-500/10 text-rose-400 flex items-center justify-center text-xl font-bold border border-rose-500/20">
          ⚠️
        </div>
        <h3 class="text-lg font-bold text-white">Prevent Stockouts & Overstocking</h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          Stop losing money on expired goods or missing sales due to empty shelves. Track exact quantities, threshold alerts, and stock values across all locations.
        </p>
      </div>

      <!-- Feature Card 2 -->
      <div class="glass-card rounded-2xl p-8 space-y-4 border border-slate-800/80 hover:border-blue-500/40 transition-all">
        <div class="w-12 h-12 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center text-xl font-bold border border-indigo-500/20">
          👥
        </div>
        <h3 class="text-lg font-bold text-white">Unified Single-Login Role Access</h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          No duplicate login systems needed. A single signup assigns users as <strong>Inventory Managers</strong> or <strong>Warehouse Staff</strong> with precise route-level authorization.
        </p>
      </div>

      <!-- Feature Card 3 -->
      <div class="glass-card rounded-2xl p-8 space-y-4 border border-slate-800/80 hover:border-blue-500/40 transition-all">
        <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-xl font-bold border border-emerald-500/20">
          📦
        </div>
        <h3 class="text-lg font-bold text-white">Streamlined Goods Operations</h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          Floor staff can execute physical goods receiving, picking/packing, internal location moves, and stock counts without risking unauthorized settings changes.
        </p>
      </div>

      <!-- Feature Card 4 -->
      <div class="glass-card rounded-2xl p-8 space-y-4 border border-slate-800/80 hover:border-blue-500/40 transition-all">
        <div class="w-12 h-12 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center text-xl font-bold border border-purple-500/20">
          🔐
        </div>
        <h3 class="text-lg font-bold text-white">Instant OTP Password Recovery</h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          Never get locked out of your warehouse system. Receive 6-digit verification OTPs directly in your email via Nodemailer integration.
        </p>
      </div>

      <!-- Feature Card 5 -->
      <div class="glass-card rounded-2xl p-8 space-y-4 border border-slate-800/80 hover:border-blue-500/40 transition-all">
        <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-xl font-bold border border-amber-500/20">
          ⚡
        </div>
        <h3 class="text-lg font-bold text-white">Real-Time Data Consistency</h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          Powered by MongoDB Atlas & Express, ensure that inventory movements reflect instantly for both decision-makers and warehouse workers.
        </p>
      </div>

      <!-- Feature Card 6 -->
      <div class="glass-card rounded-2xl p-8 space-y-4 border border-slate-800/80 hover:border-blue-500/40 transition-all">
        <div class="w-12 h-12 rounded-xl bg-teal-500/10 text-teal-400 flex items-center justify-center text-xl font-bold border border-teal-500/20">
          📊
        </div>
        <h3 class="text-lg font-bold text-white">Manager Approval Workflows</h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          Managers review physical counts, validate inventory adjustments, and approve purchase requisitions before stock is updated.
        </p>
      </div>

    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
    <div class="glass-card rounded-3xl p-10 sm:p-14 border border-blue-500/30 bg-gradient-to-r from-blue-950/60 via-slate-900 to-indigo-950/60 text-center space-y-6 relative overflow-hidden shadow-2xl">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">Ready to Transform Your Warehouse Operations?</h2>
      <p class="text-slate-300 max-w-xl mx-auto text-sm sm:text-base">Join StockSense today and start managing your catalog, stock movements, and warehouse staff effortlessly.</p>
      
      <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="/auth/signup" 
          class="px-8 py-3.5 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-bold text-sm shadow-lg shadow-blue-600/30 hover:from-blue-500 hover:to-indigo-500 transition-all"
        >
          Create Free Account
        </a>
        <a 
          href="/auth/login" 
          class="px-8 py-3.5 rounded-xl bg-slate-800 text-slate-200 hover:text-white font-semibold text-sm border border-slate-700 hover:border-slate-500 transition-all"
        >
          Already Registered? Sign In
        </a>
      </div>
    </div>
  </section>

  <%- include('layout/footer') %>
</div>
