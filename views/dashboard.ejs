<%- include('layout/app-top') %>

<div class="space-y-8">
    
    <!-- Welcome Banner -->
    <div class="glass-card rounded-2xl p-6 sm:p-8 border border-slate-800 bg-gradient-to-r from-slate-900 via-slate-900/90 to-blue-950/40 relative overflow-hidden">
      <div class="relative z-10 max-w-2xl space-y-3">
        <div class="inline-block px-3 py-1 rounded-lg text-xs font-semibold bg-blue-500/10 text-blue-400 border border-blue-500/20">
          Role-Based Access Control Active
        </div>
        <h1 class="text-3xl font-extrabold text-white tracking-tight">
          Welcome back, <%= user.name %> 👋
        </h1>
        <p class="text-sm text-slate-300 leading-relaxed">
          <% if (user.role === 'manager') { %>
            You have <strong>Inventory Manager</strong> privileges. You can manage products, categories, warehouse locations, validate stock adjustments, and view system reports.
          <% } else { %>
            You have <strong>Warehouse Staff</strong> permissions. You are assigned to physical stock receiving, order picking & packing, internal inventory transfers, and stock counts.
          <% } %>
        </p>
      </div>
    </div>

    <!-- Role Permission Overview Cards -->
    <div class="space-y-4">
      <h2 class="text-lg font-bold text-white flex items-center">
        <svg class="w-5 h-5 mr-2 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        Role Capabilities & Operations
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- 1. Catalog & Product Management -->
        <div class="glass-card rounded-2xl p-6 border border-slate-800 flex flex-col justify-between hover:border-slate-700 transition-all">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center font-bold">
              📦
            </div>
            <h3 class="text-base font-bold text-white">Catalog & Products</h3>
            <p class="text-xs text-slate-400">Create & edit products, set reorder levels, manage categories.</p>
          </div>
          <div class="mt-4 pt-4 border-t border-slate-800/80 flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-400">Permission:</span>
            <% if (user.role === 'manager') { %>
              <span class="text-xs font-bold text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-md border border-emerald-500/20">Allowed (Manager)</span>
            <% } else { %>
              <span class="text-xs font-bold text-slate-500 bg-slate-800 px-2.5 py-1 rounded-md">View Only</span>
            <% } %>
          </div>
        </div>

        <!-- 2. Physical Receiving & Goods Inward -->
        <div class="glass-card rounded-2xl p-6 border border-slate-800 flex flex-col justify-between hover:border-slate-700 transition-all">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center font-bold">
              🚚
            </div>
            <h3 class="text-base font-bold text-white">Receiving Goods</h3>
            <p class="text-xs text-slate-400">Receive shipments, inspect quality, record incoming stock quantities.</p>
          </div>
          <div class="mt-4 pt-4 border-t border-slate-800/80 flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-400">Permission:</span>
            <span class="text-xs font-bold text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-md border border-emerald-500/20">Allowed (Staff & Manager)</span>
          </div>
        </div>

        <!-- 3. Picking & Packing Delivery Orders -->
        <div class="glass-card rounded-2xl p-6 border border-slate-800 flex flex-col justify-between hover:border-slate-700 transition-all">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center font-bold">
              📋
            </div>
            <h3 class="text-base font-bold text-white">Picking & Packing</h3>
            <p class="text-xs text-slate-400">Process delivery orders, pick stock from bins, pack shipments.</p>
          </div>
          <div class="mt-4 pt-4 border-t border-slate-800/80 flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-400">Permission:</span>
            <span class="text-xs font-bold text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-md border border-emerald-500/20">Allowed (Staff & Manager)</span>
          </div>
        </div>

        <!-- 4. Internal Transfers -->
        <div class="glass-card rounded-2xl p-6 border border-slate-800 flex flex-col justify-between hover:border-slate-700 transition-all">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-xl bg-teal-500/10 text-teal-400 flex items-center justify-center font-bold">
              🔄
            </div>
            <h3 class="text-base font-bold text-white">Internal Transfers</h3>
            <p class="text-xs text-slate-400">Move inventory between racks, zones, or warehouse facilities.</p>
          </div>
          <div class="mt-4 pt-4 border-t border-slate-800/80 flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-400">Permission:</span>
            <span class="text-xs font-bold text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-md border border-emerald-500/20">Allowed (Staff & Manager)</span>
          </div>
        </div>

        <!-- 5. Physical Stock Counting & Adjustments -->
        <div class="glass-card rounded-2xl p-6 border border-slate-800 flex flex-col justify-between hover:border-slate-700 transition-all">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center font-bold">
              📊
            </div>
            <h3 class="text-base font-bold text-white">Stock Counting & Validation</h3>
            <p class="text-xs text-slate-400">Staff perform counts; Managers approve & validate adjustments.</p>
          </div>
          <div class="mt-4 pt-4 border-t border-slate-800/80 flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-400">Permission:</span>
            <% if (user.role === 'manager') { %>
              <span class="text-xs font-bold text-purple-400 bg-purple-500/10 px-2.5 py-1 rounded-md border border-purple-500/20">Full Approval</span>
            <% } else { %>
              <span class="text-xs font-bold text-amber-400 bg-amber-500/10 px-2.5 py-1 rounded-md border border-amber-500/20">Physical Count Only</span>
            <% } %>
          </div>
        </div>

        <!-- 6. Warehouse Settings & User Admin -->
        <div class="glass-card rounded-2xl p-6 border border-slate-800 flex flex-col justify-between hover:border-slate-700 transition-all">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-xl bg-rose-500/10 text-rose-400 flex items-center justify-center font-bold">
              ⚙️
            </div>
            <h3 class="text-base font-bold text-white">Warehouse Settings</h3>
            <p class="text-xs text-slate-400">Configure warehouses, locations, and manage team members.</p>
          </div>
          <div class="mt-4 pt-4 border-t border-slate-800/80 flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-400">Permission:</span>
            <% if (user.role === 'manager') { %>
              <span class="text-xs font-bold text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-md border border-emerald-500/20">Allowed (Manager)</span>
            <% } else { %>
              <span class="text-xs font-bold text-red-400 bg-red-500/10 px-2.5 py-1 rounded-md border border-red-500/20">Restricted (Staff)</span>
            <% } %>
          </div>
        </div>

      </div>
    </div>

    <!-- Test Role Permission Link -->
    <div class="glass-card rounded-2xl p-6 border border-slate-800 space-y-3">
      <h3 class="text-sm font-bold text-white">🧪 Test Route-Level Permission Enforcement</h3>
      <p class="text-xs text-slate-400">Click below to test server-side role validation middleware (<code class="text-blue-400">authorize('manager')</code>):</p>
      <div class="flex flex-wrap gap-3">
        <a 
          href="/manager/catalog" 
          class="px-4 py-2 rounded-xl text-xs font-semibold bg-purple-600/20 text-purple-300 border border-purple-500/30 hover:bg-purple-600/30 transition-all"
        >
          Try Manager-Only Route (/manager/catalog)
        </a>
        <a 
          href="/staff/receiving" 
          class="px-4 py-2 rounded-xl text-xs font-semibold bg-blue-600/20 text-blue-300 border border-blue-500/30 hover:bg-blue-600/30 transition-all"
        >
          Try Shared Operations Route (/staff/receiving)
        </a>
      </div>
    </div>

</div>

<%- include('layout/app-bottom') %>
