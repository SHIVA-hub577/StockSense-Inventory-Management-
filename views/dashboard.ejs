<%- include('layout/app-top') %>
<%
  const f = filters;
  const q = (extra) => buildQuery({ warehouse: f.warehouse }, extra);
  const typeOptions = [['', 'All documents'], ['receipt', 'Receipts'], ['delivery', 'Delivery orders'], ['internal', 'Internal transfers'], ['adjustment', 'Stock counts']];
  const statusOptions = [['', 'Pending (open)'], ['draft', 'Draft'], ['waiting', 'Waiting'], ['ready', 'Ready'], ['done', 'Done'], ['canceled', 'Canceled']];
  const opsLabel = ops.statusLabel === 'pending' ? 'pending' : STATUS_META[ops.statusLabel].label.toLowerCase();
  const kpis = [
    { label: 'Products in stock', value: stock.inStock, sub: `of ${stock.products} · ${fmtMoney(stock.value)}`, href: '/products?status=instock', icon: 'products', tone: 'text-white' },
    { label: 'Low stock', value: stock.low, sub: 'at or below reorder level', href: '/products?status=low', icon: 'warning', tone: stock.low ? 'text-amber-400' : 'text-white' },
    { label: 'Out of stock', value: stock.out, sub: 'nothing on hand', href: '/products?status=out', icon: 'warning', tone: stock.out ? 'text-red-400' : 'text-white' },
    { label: 'Receipts', value: ops.receipts, sub: opsLabel, href: '/receipts' + q({ tab: f.status || 'todo' }), icon: 'receipts', tone: 'text-white', type: 'receipt' },
    { label: 'Deliveries', value: ops.deliveries, sub: opsLabel, href: '/deliveries' + q({ tab: f.status || 'todo' }), icon: 'deliveries', tone: 'text-white', type: 'delivery' },
    { label: 'Transfers scheduled', value: ops.transfers, sub: opsLabel, href: '/transfers' + q({ tab: f.status || 'todo' }), icon: 'transfers', tone: 'text-white', type: 'internal' },
  ];
  const columns = [
    { key: 'toReceive', label: 'To receive', tone: 'text-blue-300' },
    { key: 'toPick', label: 'To pick', tone: 'text-blue-300' },
    { key: 'toPack', label: 'To pack', tone: 'text-blue-300' },
    { key: 'readyToShip', label: 'Ready to ship', tone: 'text-emerald-400' },
    { key: 'late', label: 'Late', tone: 'text-red-400' },
  ];
%>

<div class="flex flex-col xl:flex-row xl:items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold text-white tracking-tight">Inventory overview</h1>
    <p class="text-sm text-slate-400 mt-1"><%= fmtDate(new Date()) %> · <%= user.role === 'manager' ? 'Inventory Manager' : 'Warehouse Staff' %> view<% if (ops.late) { %> · <a href="/dashboard#board" class="text-red-400 hover:text-red-300"><%= ops.late %> late</a><% } %></p>
  </div>
  <!-- Dynamic filters -->
  <form method="GET" action="/dashboard" id="dashFilters" class="grid grid-cols-2 lg:grid-cols-4 gap-2" aria-label="Dashboard filters">
    <select name="type" class="input py-2" aria-label="Document type">
      <% typeOptions.forEach(([v, l]) => { %><option value="<%= v %>" <%= f.type === v ? 'selected' : '' %>><%= l %></option><% }) %>
    </select>
    <select name="status" class="input py-2" aria-label="Status">
      <% statusOptions.forEach(([v, l]) => { %><option value="<%= v %>" <%= f.status === v ? 'selected' : '' %>><%= l %></option><% }) %>
    </select>
    <select name="warehouse" class="input py-2" aria-label="Warehouse">
      <option value="">All warehouses</option>
      <% warehouses.forEach((w) => { %><option value="<%= w._id %>" <%= String(w._id) === f.warehouse ? 'selected' : '' %>><%= w.name %></option><% }) %>
    </select>
    <select name="category" class="input py-2" aria-label="Product category">
      <option value="">All categories</option>
      <% categories.forEach((c) => { %><option value="<%= c._id %>" <%= String(c._id) === f.category ? 'selected' : '' %>><%= c.name %></option><% }) %>
    </select>
  </form>
</div>

<!-- KPIs -->
<section data-live-region="kpis" class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-4 rounded-2xl transition-shadow" aria-label="Key figures">
  <% kpis.forEach((k) => { const dim = f.type && k.type && k.type !== f.type; %>
    <a href="<%= k.href %>" class="card p-4 hover:border-slate-600 transition-colors <%= dim ? 'opacity-40' : '' %>">
      <div class="flex items-center justify-between text-slate-400">
        <p class="text-xs font-semibold uppercase tracking-wider"><%= k.label %></p>
        <%- icon(k.icon, 'w-4 h-4') %>
      </div>
      <p class="mt-3 text-3xl font-bold tabular-nums <%= k.tone %>"><%= k.value %></p>
      <p class="text-xs text-slate-500 mt-1 truncate"><%= k.sub %></p>
    </a>
  <% }) %>
</section>

<!-- Today board -->
<section id="board" class="space-y-3">
  <div class="flex items-center justify-between">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-400">Today's work</h2>
    <a href="/scan" class="text-xs text-blue-400 hover:text-blue-300">Open scanner →</a>
  </div>
  <div data-live-region="board" class="grid sm:grid-cols-2 xl:grid-cols-5 gap-4 rounded-2xl transition-shadow">
    <% columns.forEach((col) => { const c = board[col.key]; %>
      <div class="card p-4 space-y-3 min-h-[9rem]">
        <div class="flex items-center justify-between">
          <p class="text-sm font-semibold <%= col.tone %>"><%= col.label %></p>
          <span class="text-xs font-bold rounded-full px-2 py-0.5 <%= c.count ? (col.key === 'late' ? 'bg-red-500/15 text-red-300' : 'bg-slate-800 text-slate-200') : 'bg-slate-800/50 text-slate-500' %>"><%= c.count %></span>
        </div>
        <% if (c.items.length === 0) { %>
          <p class="text-xs text-slate-500"><%= col.key === 'late' ? 'Nothing late' : 'All clear' %></p>
        <% } else { %>
          <ul class="space-y-2">
            <% c.items.forEach((op) => { %>
              <li>
                <a href="/operations/<%= op._id %>" class="block rounded-lg px-2 py-1.5 -mx-2 hover:bg-slate-800/60">
                  <span class="font-mono text-xs text-blue-300"><%= op.reference %></span>
                  <span class="block text-xs text-slate-400 truncate"><%= op.partner || OPERATION_META[op.type].label %> · <%= fmtRelativeDays(op.scheduledDate) %></span>
                </a>
              </li>
            <% }) %>
          </ul>
          <% if (c.count > c.items.length) { %><p class="text-xs text-slate-500">+<%= c.count - c.items.length %> more</p><% } %>
        <% } %>
      </div>
    <% }) %>
  </div>
</section>

<div class="grid xl:grid-cols-3 gap-6">
  <!-- Flow chart -->
  <section class="card p-5 xl:col-span-2 space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-sm font-semibold text-white">Stock flow · last 14 days</h2>
        <p class="text-xs text-slate-500">Value of goods coming in vs going out</p>
      </div>
      <a href="/moves" class="text-xs text-blue-400 hover:text-blue-300">Move history →</a>
    </div>
    <div class="h-64"><canvas id="flowChart" aria-label="Stock value in and out per day" role="img"></canvas></div>
    <div data-live-region="flowdata" hidden><script type="application/json" id="flowData"><%- jsonForScript(chart) %></script></div>
  </section>

  <!-- Forecast warnings -->
  <section class="card overflow-hidden">
    <div class="flex items-center justify-between px-4 py-3 border-b border-slate-800">
      <h2 class="text-sm font-semibold text-white">Stock outlook</h2>
      <a href="/replenishment" class="text-xs text-blue-400 hover:text-blue-300">Replenish →</a>
    </div>
    <ul data-live-region="warnings" class="divide-y divide-slate-800 transition-shadow">
      <% if (warnings.length === 0) { %>
        <li class="px-4 py-8 text-center text-sm text-slate-400">Everything is healthy for the next 30 days</li>
      <% } %>
      <% warnings.forEach(({ product, forecast }) => { const o = OUTLOOK_META[forecast.status]; %>
        <li class="px-4 py-3 flex items-start justify-between gap-3">
          <div class="min-w-0">
            <a href="/products/<%= product._id %>" class="block text-sm font-medium text-white hover:text-blue-300 truncate"><%= product.name %></a>
            <p class="text-xs text-slate-400">
              <%= fmtQty(forecast.onHand) %> <%= product.uom %> left
              <% if (forecast.stockoutDate && forecast.status !== 'out') { %>· runs out <%= fmtRelativeDays(forecast.stockoutDate) %><% } %>
              <% if (forecast.orderByDate) { %>· order <%= new Date(forecast.orderByDate) <= new Date() ? 'now' : 'by ' + fmtDate(forecast.orderByDate) %><% } %>
            </p>
          </div>
          <span class="badge <%= o.classes %>"><%= o.label %></span>
        </li>
      <% }) %>
    </ul>
  </section>
</div>

<div class="grid xl:grid-cols-3 gap-6">
  <!-- Operations (all four filters) -->
  <section class="card overflow-hidden xl:col-span-2">
    <div class="flex items-center justify-between px-4 py-3 border-b border-slate-800">
      <h2 class="text-sm font-semibold text-white">Operations <span class="font-normal text-slate-500">· most recently updated</span></h2>
    </div>
    <div data-live-region="operations" class="overflow-x-auto transition-shadow">
      <% if (operations.length === 0) { %>
        <p class="px-4 py-8 text-center text-sm text-slate-400">No operations match these filters</p>
      <% } else { %>
        <table class="min-w-full">
          <thead class="bg-slate-900/80"><tr><th class="th">Reference</th><th class="th">Type</th><th class="th">Partner / route</th><th class="th">Scheduled</th><th class="th">Status</th></tr></thead>
          <tbody>
            <% operations.forEach((op) => { %>
              <tr class="border-t border-slate-800 hover:bg-slate-800/30">
                <td class="td"><a href="/operations/<%= op._id %>" class="font-mono text-blue-300 hover:text-blue-200"><%= op.reference %></a></td>
                <td class="td text-slate-400"><%= OPERATION_META[op.type].label %></td>
                <td class="td text-slate-300 truncate max-w-[16rem]"><%= op.type === 'adjustment' ? `Count · ${op.sourceLocation.fullName}` : op.partner || `${op.sourceLocation.fullName} → ${op.destLocation.fullName}` %></td>
                <td class="td whitespace-nowrap <%= isLate(op) ? 'text-red-400' : 'text-slate-400' %>"><%= fmtDate(op.scheduledDate) %></td>
                <td class="td"><span class="badge <%= STATUS_META[op.status].classes %>"><%= STATUS_META[op.status].label %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </section>

  <!-- Live activity -->
  <section class="card overflow-hidden">
    <div class="flex items-center justify-between px-4 py-3 border-b border-slate-800">
      <h2 class="text-sm font-semibold text-white">Live activity</h2>
      <span class="flex items-center gap-1.5 text-xs text-emerald-400"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>live</span>
    </div>
    <ul id="activityFeed" class="divide-y divide-slate-800 max-h-[26rem] overflow-y-auto">
      <% if (feed.length === 0) { %>
        <li id="activityEmpty" class="px-4 py-8 text-center text-sm text-slate-400">Nothing yet - actions by anyone appear here instantly</li>
      <% } %>
      <% feed.forEach((a) => { %>
        <li class="px-4 py-3 flex gap-3">
          <span class="mt-1.5 w-2 h-2 shrink-0 rounded-full <%= a.action === 'validated' ? 'bg-emerald-400' : a.action === 'canceled' ? 'bg-red-400' : 'bg-slate-500' %>"></span>
          <div class="min-w-0">
            <a href="/operations/<%= a.subject %>" class="block text-sm text-slate-200 hover:text-white"><%= a.message %></a>
            <p class="text-xs text-slate-500"><%= fmtAgo(a.createdAt) %></p>
          </div>
        </li>
      <% }) %>
    </ul>
  </section>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
  (() => {
    // Filters apply as soon as they change
    const form = document.getElementById('dashFilters');
    form.addEventListener('change', () => {
      const params = new URLSearchParams(new FormData(form));
      [...params.keys()].forEach((k) => { if (!params.get(k)) params.delete(k); });
      window.location.search = params.toString();
    });

    let chart;
    const money = (v) => Number(v).toLocaleString('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 });
    function drawChart() {
      if (!window.Chart) return;
      const data = JSON.parse(document.getElementById('flowData').textContent);
      const labels = data.map((d) => new Date(d.day + 'T00:00:00').toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }));
      if (chart) chart.destroy();
      chart = new Chart(document.getElementById('flowChart'), {
        type: 'bar',
        data: {
          labels,
          datasets: [
            { label: 'In', data: data.map((d) => d.in), backgroundColor: 'rgba(52, 211, 153, 0.75)', borderRadius: 4 },
            { label: 'Out', data: data.map((d) => d.out), backgroundColor: 'rgba(248, 113, 113, 0.75)', borderRadius: 4 },
          ],
        },
        options: {
          maintainAspectRatio: false,
          animation: { duration: 300 },
          plugins: {
            legend: { labels: { color: '#94a3b8', boxWidth: 12 } },
            tooltip: { callbacks: { label: (c) => `${c.dataset.label}: ${money(c.parsed.y)}` } },
          },
          scales: {
            x: { ticks: { color: '#64748b' }, grid: { display: false } },
            y: { ticks: { color: '#64748b', callback: (v) => money(v) }, grid: { color: 'rgba(148, 163, 184, 0.1)' } },
          },
        },
      });
    }
    drawChart();
    document.addEventListener('stocksense:regions-updated', drawChart);
  })();
</script>

<%- include('layout/app-bottom') %>
