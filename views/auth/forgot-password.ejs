<%- include('../layout/auth-top') %>

<div class="space-y-2">
  <span class="tile w-11 h-11 rounded-xl bg-accent-soft text-accent-text mb-2"><%- icon('info', 'w-5 h-5') %></span>
  <h1 class="font-display text-[2.2rem] font-bold leading-[1.05] tracking-[-0.035em]">Forgot your password?</h1>
  <p class="text-sm text-muted">Enter your registered email and we will send you a 6-digit code to reset it.</p>
</div>

<div id="alertBox" class="<%= error ? '' : 'hidden' %> flex items-start gap-2.5 rounded-xl border border-bad/30 bg-bad-soft p-3.5 text-sm font-medium text-bad" role="alert"><%= error %></div>

<form id="forgotForm" class="space-y-5" novalidate>
  <div>
    <label for="email" class="label">Email address</label>
    <input type="email" id="email" name="email" required autocomplete="email" placeholder="name@company.com" class="input h-12">
  </div>
  <button type="submit" id="submitBtn" class="btn btn-primary btn-lg w-full" data-magnetic>Send reset code <%- icon('arrowRight', 'w-4 h-4') %></button>
</form>

<p class="text-sm text-center"><a href="/auth/login" class="link">← Back to sign in</a></p>

<script>
  (() => {
    const { authAlert, setBusy } = window.StockSense;
    const alertBox = document.getElementById('alertBox');
    const submitBtn = document.getElementById('submitBtn');
    document.getElementById('forgotForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('email').value.trim();
      if (!email) return authAlert(alertBox, 'Enter the email you signed up with.', 'error');
      setBusy(submitBtn, true, 'Sending code...');
      try {
        const res = await fetch('/auth/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          authAlert(alertBox, `${data.message} Taking you to the code page...`, 'success');
          setTimeout(() => { window.location.href = `/auth/verify-otp?email=${encodeURIComponent(email)}`; }, 1100);
        } else {
          authAlert(alertBox, data.message || 'Failed to send the code. Please check your email.', 'error');
          setBusy(submitBtn, false);
        }
      } catch (err) {
        authAlert(alertBox, 'Network error. Please try again.', 'error');
        setBusy(submitBtn, false);
      }
    });
  })();
</script>

<%- include('../layout/auth-bottom') %>
