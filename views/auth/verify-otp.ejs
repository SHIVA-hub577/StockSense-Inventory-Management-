<%- include('../layout/auth-top') %>

<div class="space-y-2">
  <span class="tile w-11 h-11 rounded-xl bg-accent-soft text-accent-text mb-2"><%- icon('check', 'w-5 h-5') %></span>
  <h1 class="font-display text-[2.2rem] font-bold leading-[1.05] tracking-[-0.035em]">Check your inbox</h1>
  <p class="text-sm text-muted">Enter the 6-digit code sent to <span id="displayEmail" class="font-semibold text-ink"><%= email || 'your email' %></span>.</p>
</div>

<div id="alertBox" class="<%= error ? '' : 'hidden' %> flex items-start gap-2.5 rounded-xl border border-bad/30 bg-bad-soft p-3.5 text-sm font-medium text-bad" role="alert"><%= error %></div>

<form id="verifyForm" class="space-y-5" novalidate>
  <input type="hidden" id="email" name="email" value="<%= email %>">
  <div class="space-y-2">
    <p class="label" id="otpLabel">Verification code</p>
    <div id="otpBoxes" class="grid grid-cols-6 gap-2" role="group" aria-labelledby="otpLabel"></div>
    <input type="hidden" id="otp" name="otp">
  </div>
  <button type="submit" id="submitBtn" class="btn btn-primary btn-lg w-full" data-magnetic>Verify code</button>
</form>

<div class="flex items-center justify-between text-sm">
  <a href="/auth/forgot-password" class="link">Resend code</a>
  <a href="/auth/login" class="link">Back to sign in</a>
</div>

<script>
  (() => {
    const { authAlert, setBusy, otpBoxes } = window.StockSense;
    const form = document.getElementById('verifyForm');
    const alertBox = document.getElementById('alertBox');
    const submitBtn = document.getElementById('submitBtn');
    const otpInput = document.getElementById('otp');
    // A complete code submits on its own
    const boxes = otpBoxes(document.getElementById('otpBoxes'), otpInput, { onComplete: () => form.requestSubmit() });
    boxes.focus();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitBtn.disabled) return;
      const email = document.getElementById('email').value.trim();
      const otp = otpInput.value.trim();
      if (otp.length < 6) {
        boxes.shake();
        return authAlert(alertBox, 'Enter all 6 digits of the code.', 'error');
      }
      setBusy(submitBtn, true, 'Verifying...');
      try {
        const res = await fetch('/auth/verify-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, otp }),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          authAlert(alertBox, `${data.message} Taking you to set a new password...`, 'success');
          // Reset endpoint re-validates the OTP, so carry it to the next page (not in the URL)
          try { sessionStorage.setItem('resetOtp', otp); } catch (err) {}
          setTimeout(() => { window.location.href = `/auth/reset-password?email=${encodeURIComponent(email)}`; }, 900);
        } else {
          authAlert(alertBox, data.message || 'Verification failed. Please check the code.', 'error');
          boxes.shake();
          setBusy(submitBtn, false);
        }
      } catch (err) {
        authAlert(alertBox, 'Network error. Please try again.', 'error');
        setBusy(submitBtn, false);
      }
    });
  })();
</script>

<%- include('../layout/auth-bottom') %>
