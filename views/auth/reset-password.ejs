<%- include('../layout/header') %>

<main class="flex-grow flex items-center justify-center p-4">
  <div class="w-full max-w-md glass-card rounded-2xl shadow-2xl p-8 space-y-6 border border-slate-800">
    <div class="text-center space-y-2">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-emerald-600/20 text-emerald-400 mb-2 ring-1 ring-emerald-500/30">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-white">Reset Password</h1>
      <p class="text-sm text-slate-400">Set a new secure password for <span class="text-blue-400 font-semibold"><%= email || 'your account' %></span></p>
    </div>

    <div id="alertBox" class="<%= error ? '' : 'hidden' %> p-4 rounded-xl text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20">
      <%= error %>
    </div>

    <form id="resetForm" class="space-y-4">
      <input type="hidden" id="email" name="email" value="<%= email %>" />

      <div>
        <label for="newPassword" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1">New Password (min 6 chars)</label>
        <input 
          type="password" 
          id="newPassword" 
          name="newPassword" 
          required 
          minlength="6"
          placeholder="••••••••"
          class="w-full px-4 py-3 rounded-xl bg-slate-900/90 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 text-sm"
        />
      </div>

      <div>
        <label for="confirmPassword" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1">Confirm New Password</label>
        <input 
          type="password" 
          id="confirmPassword" 
          name="confirmPassword" 
          required 
          minlength="6"
          placeholder="••••••••"
          class="w-full px-4 py-3 rounded-xl bg-slate-900/90 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 text-sm"
        />
      </div>

      <button 
        type="submit" 
        id="submitBtn"
        class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-semibold text-sm hover:from-emerald-500 hover:to-teal-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all shadow-lg shadow-emerald-600/25"
      >
        Update Password
      </button>
    </form>

    <div class="text-center pt-2 border-t border-slate-800/60">
      <a href="/auth/login" class="text-xs font-medium text-slate-400 hover:text-white transition-colors">Back to Login</a>
    </div>
  </div>
</main>

<script>
  document.getElementById('resetForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const alertBox = document.getElementById('alertBox');
    const submitBtn = document.getElementById('submitBtn');

    alertBox.classList.add('hidden');

    const email = document.getElementById('email').value.trim();
    let otp = '';
    try { otp = sessionStorage.getItem('resetOtp') || ''; } catch (e) {}
    const newPassword = document.getElementById('newPassword').value;
    const confirmPassword = document.getElementById('confirmPassword').value;

    if (newPassword !== confirmPassword) {
      alertBox.className = 'p-4 rounded-xl text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20';
      alertBox.innerText = 'Passwords do not match.';
      alertBox.classList.remove('hidden');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.innerText = 'Updating Password...';

    try {
      const res = await fetch('/auth/reset-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, otp, newPassword }),
      });

      const data = await res.json();

      if (res.ok && data.success) {
        try { sessionStorage.removeItem('resetOtp'); } catch (e) {}
        alertBox.className = 'p-4 rounded-xl text-sm font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20';
        alertBox.innerText = data.message + ' Redirecting to login...';
        alertBox.classList.remove('hidden');
        setTimeout(() => {
          window.location.href = `/auth/login?success=${encodeURIComponent(data.message)}`;
        }, 1200);
      } else {
        alertBox.className = 'p-4 rounded-xl text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20';
        alertBox.innerText = data.message || 'Password reset failed.';
        alertBox.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.innerText = 'Update Password';
      }
    } catch (err) {
      alertBox.className = 'p-4 rounded-xl text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20';
      alertBox.innerText = 'Network error. Please try again.';
      alertBox.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.innerText = 'Update Password';
    }
  });
</script>

<%- include('../layout/footer') %>
