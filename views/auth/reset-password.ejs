<%- include('../layout/auth-top') %>

<div class="space-y-2">
  <span class="tile w-11 h-11 rounded-xl bg-accent-soft text-accent-text mb-2"><%- icon('bolt', 'w-5 h-5') %></span>
  <h1 class="font-display text-[2.2rem] font-bold leading-[1.05] tracking-[-0.035em]">Set a new password</h1>
  <p class="text-sm text-muted">For <span class="font-semibold text-ink"><%= email || 'your account' %></span>.</p>
</div>

<div id="alertBox" class="<%= error ? '' : 'hidden' %> flex items-start gap-2.5 rounded-xl border border-bad/30 bg-bad-soft p-3.5 text-sm font-medium text-bad" role="alert"><%= error %></div>

<form id="resetForm" class="space-y-5" novalidate>
  <input type="hidden" id="email" name="email" value="<%= email %>">
  <%- include('../partials/password-field', { id: 'newPassword', name: 'newPassword', label: 'New password', autocomplete: 'new-password', minlength: 6, strength: 'resetStrength' }) %>
  <div>
    <%- include('../partials/password-field', { id: 'confirmPassword', name: 'confirmPassword', label: 'Confirm new password', autocomplete: 'new-password', minlength: 6 }) %>
    <p id="matchHint" class="mt-2 text-xs font-medium text-muted" aria-live="polite"></p>
  </div>
  <button type="submit" id="submitBtn" class="btn btn-primary btn-lg w-full" data-magnetic>Update password</button>
</form>

<p class="text-sm text-center"><a href="/auth/login" class="link">← Back to sign in</a></p>

<script>
  (() => {
    const { authAlert, setBusy } = window.StockSense;
    const alertBox = document.getElementById('alertBox');
    const submitBtn = document.getElementById('submitBtn');
    const pw = document.getElementById('newPassword');
    const confirmPw = document.getElementById('confirmPassword');
    const hint = document.getElementById('matchHint');

    const checkMatch = () => {
      if (!confirmPw.value) {
        hint.textContent = '';
        return;
      }
      const same = pw.value === confirmPw.value;
      hint.textContent = same ? '✓ Passwords match' : 'Passwords do not match yet';
      hint.className = `mt-2 text-xs font-medium ${same ? 'text-ok' : 'text-warn'}`;
    };
    pw.addEventListener('input', checkMatch);
    confirmPw.addEventListener('input', checkMatch);

    document.getElementById('resetForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('email').value.trim();
      let otp = '';
      try { otp = sessionStorage.getItem('resetOtp') || ''; } catch (err) {}
      if (pw.value.length < 6) return authAlert(alertBox, 'Use at least 6 characters.', 'error');
      if (pw.value !== confirmPw.value) return authAlert(alertBox, 'Passwords do not match.', 'error');

      setBusy(submitBtn, true, 'Updating password...');
      try {
        const res = await fetch('/auth/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, otp, newPassword: pw.value }),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          try { sessionStorage.removeItem('resetOtp'); } catch (err) {}
          authAlert(alertBox, `${data.message} Taking you to sign in...`, 'success');
          setTimeout(() => { window.location.href = `/auth/login?success=${encodeURIComponent(data.message)}`; }, 1100);
        } else {
          authAlert(alertBox, data.message || 'Password reset failed.', 'error');
          setBusy(submitBtn, false);
        }
      } catch (err) {
        authAlert(alertBox, 'Network error. Please try again.', 'error');
        setBusy(submitBtn, false);
      }
    });
  })();
</script>

<%- include('../layout/auth-bottom') %>
