<%- include('../layout/auth-top') %>

<div class="space-y-2">
  <p class="eyebrow">Welcome back</p>
  <h1 class="font-display text-[2.2rem] font-bold leading-[1.05] tracking-[-0.035em]">Sign in to your warehouse</h1>
  <p class="text-sm text-muted">Pick up where the team left off - everything is live.</p>
</div>

<div id="alertBox" class="<%= error || success ? '' : 'hidden' %> flex items-start gap-2.5 rounded-xl border p-3.5 text-sm font-medium <%= error ? 'border-bad/30 bg-bad-soft text-bad' : 'border-ok/30 bg-ok-soft text-ok' %>" role="<%= error ? 'alert' : 'status' %>"><%= error || success %></div>

<form id="loginForm" class="space-y-5" novalidate>
  <div>
    <label for="email" class="label">Email address</label>
    <input type="email" id="email" name="email" required autocomplete="email" placeholder="name@company.com" class="input h-12">
  </div>

  <%- include('../partials/password-field', { id: 'password', name: 'password', label: 'Password', autocomplete: 'current-password', extra: '<a href="/auth/forgot-password" class="text-xs font-semibold text-accent-text hover:underline underline-offset-4">Forgot password?</a>' }) %>

  <button type="submit" id="submitBtn" class="btn btn-primary btn-lg w-full" data-magnetic>Sign in <%- icon('arrowRight', 'w-4 h-4') %></button>
</form>

<p class="text-sm text-muted text-center">
  New to StockSense? <a href="/auth/signup" class="link-inline">Create an account</a>
</p>

<script>
  (() => {
    const { authAlert, setBusy } = window.StockSense;
    const form = document.getElementById('loginForm');
    const alertBox = document.getElementById('alertBox');
    const submitBtn = document.getElementById('submitBtn');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;
      if (!email || !password) return authAlert(alertBox, 'Enter your email and password.', 'error');

      setBusy(submitBtn, true, 'Signing in...');
      try {
        const res = await fetch('/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          authAlert(alertBox, 'Signed in. Opening your dashboard...', 'success');
          submitBtn.classList.replace('btn-primary', 'btn-success');
          submitBtn.innerHTML = '✓ Welcome back';
          setTimeout(() => { window.location.href = '/dashboard'; }, 500);
        } else {
          authAlert(alertBox, data.message || 'Login failed. Please check your credentials.', 'error');
          setBusy(submitBtn, false);
        }
      } catch (err) {
        authAlert(alertBox, 'Network error. Please try again.', 'error');
        setBusy(submitBtn, false);
      }
    });
  })();
</script>

<%- include('../layout/auth-bottom') %>
