<%- include('../layout/auth-top') %>

<div class="space-y-2">
  <p class="eyebrow">Create your account</p>
  <h1 class="font-display text-[2.2rem] font-bold leading-[1.05] tracking-[-0.035em]">Join the floor</h1>
  <p class="text-sm text-muted">One account, verified by a code we email you.</p>
</div>

<!-- Steps -->
<ol class="flex items-center gap-2" aria-label="Sign-up steps">
  <li class="route-step" data-state="current" id="stepDetails"><span class="route-dot">1</span> Your details</li>
  <li class="route-line" aria-hidden="true" id="stepLine"></li>
  <li class="route-step" data-state="upcoming" id="stepVerify"><span class="route-dot">2</span> Verify email</li>
</ol>

<div id="alertBox" class="<%= error ? '' : 'hidden' %> flex items-start gap-2.5 rounded-xl border border-bad/30 bg-bad-soft p-3.5 text-sm font-medium text-bad" role="alert"><%= error %></div>

<form id="signupForm" class="space-y-5" novalidate>
  <div id="detailsFields" class="space-y-5">
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label for="name" class="label">Full name *</label>
        <input type="text" id="name" name="name" required autocomplete="name" placeholder="Your name" class="input h-12">
      </div>
      <div>
        <label for="phone" class="label">Phone <span class="font-normal text-muted">(optional)</span></label>
        <input type="tel" id="phone" name="phone" autocomplete="tel" placeholder="+91 ..." class="input h-12">
      </div>
    </div>

    <div>
      <label for="email" class="label">Work email *</label>
      <input type="email" id="email" name="email" required autocomplete="email" placeholder="name@company.com" class="input h-12">
    </div>

    <fieldset>
      <legend class="label">Your role *</legend>
      <div class="grid grid-cols-2 gap-3">
        <label class="role-card">
          <input type="radio" name="role" value="manager" checked class="sr-only">
          <span class="role-check"><%- icon('check', 'w-3 h-3') %></span>
          <span class="avatar avatar-sm avatar-manager">IM</span>
          <span class="text-sm font-semibold">Inventory Manager</span>
          <span class="text-xs text-muted">Products, rules, approves counts</span>
        </label>
        <label class="role-card">
          <input type="radio" name="role" value="staff" class="sr-only">
          <span class="role-check"><%- icon('check', 'w-3 h-3') %></span>
          <span class="avatar avatar-sm avatar-staff">WS</span>
          <span class="text-sm font-semibold">Warehouse Staff</span>
          <span class="text-xs text-muted">Receive, pick, move, count</span>
        </label>
      </div>
    </fieldset>

    <%- include('../partials/password-field', { id: 'password', name: 'password', label: 'Password *', autocomplete: 'new-password', minlength: 6, strength: 'signupStrength' }) %>
  </div>

  <!-- Step 2: OTP -->
  <div id="otpContainer" class="hidden space-y-3">
    <div class="rounded-xl border border-line bg-surface-2 p-4 text-sm text-ink-2">
      We sent a 6-digit code to <strong id="otpEmail" class="text-ink"></strong>. It expires in 10 minutes.
      <button type="button" id="changeEmail" class="ml-1 font-semibold text-accent-text hover:underline underline-offset-4">Change</button>
    </div>
    <label class="label" id="otpLabel">Verification code *</label>
    <div id="otpBoxes" class="grid grid-cols-6 gap-2" role="group" aria-labelledby="otpLabel"></div>
    <input type="hidden" id="otp" name="otp">
  </div>

  <button type="button" id="sendOtpBtn" class="btn btn-primary btn-lg w-full" data-magnetic>Send verification code <%- icon('arrowRight', 'w-4 h-4') %></button>
  <button type="submit" id="submitBtn" class="hidden btn btn-accent btn-lg w-full">Verify &amp; create account</button>
</form>

<p class="text-sm text-muted text-center">
  Already have an account? <a href="/auth/login" class="link-inline">Sign in</a>
</p>

<script>
  (() => {
    const { authAlert, setBusy, otpBoxes } = window.StockSense;
    const sendOtpBtn = document.getElementById('sendOtpBtn');
    const submitBtn = document.getElementById('submitBtn');
    const otpContainer = document.getElementById('otpContainer');
    const details = document.getElementById('detailsFields');
    const alertBox = document.getElementById('alertBox');
    const emailInput = document.getElementById('email');
    const otpInput = document.getElementById('otp');
    const boxes = otpBoxes(document.getElementById('otpBoxes'), otpInput, {
      onComplete: () => submitBtn.focus(),
    });

    const setStep = (n) => {
      document.getElementById('stepDetails').dataset.state = n === 1 ? 'current' : 'done';
      document.getElementById('stepVerify').dataset.state = n === 2 ? 'current' : 'upcoming';
      document.getElementById('stepLine').dataset.state = n === 2 ? 'done' : '';
      details.classList.toggle('hidden', n === 2);
      otpContainer.classList.toggle('hidden', n !== 2);
      sendOtpBtn.classList.toggle('hidden', n === 2);
      submitBtn.classList.toggle('hidden', n !== 2);
      if (n === 2) {
        document.getElementById('otpEmail').textContent = emailInput.value.trim();
        otpContainer.classList.add('animate-fade-up');
        boxes.focus();
      }
    };

    document.getElementById('changeEmail').addEventListener('click', () => {
      setStep(1);
      emailInput.focus();
    });

    // Step 1: check the details, then email a code
    sendOtpBtn.addEventListener('click', async () => {
      alertBox.classList.add('hidden');
      const name = document.getElementById('name').value.trim();
      const email = emailInput.value.trim();
      const password = document.getElementById('password').value;
      if (!name) return authAlert(alertBox, 'Please enter your name.', 'error');
      if (!email) return authAlert(alertBox, 'Please enter your email address first.', 'error');
      if (password.length < 6) return authAlert(alertBox, 'Choose a password of at least 6 characters.', 'error');

      setBusy(sendOtpBtn, true, 'Sending code...');
      try {
        const res = await fetch('/auth/send-signup-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const data = await res.json();
        setBusy(sendOtpBtn, false);
        if (res.ok && data.success) {
          authAlert(alertBox, data.message, 'success');
          setStep(2);
        } else {
          authAlert(alertBox, data.message || 'Failed to send the code.', 'error');
        }
      } catch (err) {
        setBusy(sendOtpBtn, false);
        authAlert(alertBox, 'Network error. Please try again.', 'error');
      }
    });

    // Step 2: verify the code and create the account
    document.getElementById('signupForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitBtn.classList.contains('hidden')) return sendOtpBtn.click();
      const otp = otpInput.value.trim();
      if (otp.length < 6) {
        boxes.shake();
        return authAlert(alertBox, 'Enter the 6-digit code from your email.', 'error');
      }
      const roleInput = document.querySelector('input[name="role"]:checked');
      const body = {
        name: document.getElementById('name').value.trim(),
        email: emailInput.value.trim(),
        password: document.getElementById('password').value,
        role: roleInput ? roleInput.value : 'staff',
        phone: document.getElementById('phone').value.trim(),
        otp,
      };

      setBusy(submitBtn, true, 'Creating account...');
      try {
        const res = await fetch('/auth/signup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          authAlert(alertBox, 'Code verified - your account is ready. Opening the dashboard...', 'success');
          submitBtn.classList.replace('btn-accent', 'btn-success');
          submitBtn.innerHTML = '✓ Account created';
          setTimeout(() => { window.location.href = '/dashboard'; }, 800);
        } else {
          authAlert(alertBox, data.message || 'The code is invalid or expired.', 'error');
          boxes.shake();
          setBusy(submitBtn, false);
        }
      } catch (err) {
        authAlert(alertBox, 'Network error. Please try again.', 'error');
        setBusy(submitBtn, false);
      }
    });
  })();
</script>

<%- include('../layout/auth-bottom') %>
