<%- include('layout/head') %>
<%
  const code = typeof statusCode !== 'undefined' ? statusCode : 500;
  const heading = typeof title !== 'undefined' ? title : 'Access Denied';
  const text = typeof message !== 'undefined' ? message : 'You do not have permission to view this page.';
  const loggedIn = typeof user !== 'undefined' && user;
  const kind = code === 404 ? 'lost' : code === 403 ? 'locked' : 'broken';
  const kicker = { lost: 'This aisle is empty', locked: 'Restricted area', broken: 'Something tipped over' }[kind];
%>
<script src="/js/app.js"></script>
<main id="main-content" class="min-h-dvh floor flex flex-col items-center justify-center px-5 py-16 text-center">
  <a href="/" class="mb-10 flex items-center gap-2.5" aria-label="StockSense home">
    <%- include('partials/logo', { cls: 'w-8 h-8' }) %>
    <span class="font-display text-[1.1rem] font-bold tracking-tight">StockSense</span>
  </a>

  <svg class="error-art w-full max-w-md h-auto" viewBox="0 0 420 220" fill="none" aria-hidden="true" stroke-linecap="round" stroke-linejoin="round">
    <ellipse cx="210" cy="206" rx="170" ry="8" style="fill: var(--sunken)"/>
    <text x="210" y="150" text-anchor="middle" class="error-code" style="fill: var(--line)"><%= code %></text>
    <% if (kind === 'lost') { %>
      <!-- A forklift looking for a pallet that isn't there -->
      <g class="err-forklift">
        <rect x="70" y="150" width="70" height="36" rx="6" style="fill: var(--accent); stroke: var(--ink)" stroke-width="3"/>
        <path d="M84 150 V116 H126 V150" style="stroke: var(--ink)" stroke-width="4"/>
        <rect x="144" y="100" width="8" height="86" style="fill: var(--ink)"/>
        <rect x="150" y="178" width="52" height="6" style="fill: var(--ink)"/>
        <circle cx="90" cy="192" r="12" style="fill: var(--ink)"/><circle cx="90" cy="192" r="4" style="fill: var(--surface)"/>
        <circle cx="128" cy="192" r="12" style="fill: var(--ink)"/><circle cx="128" cy="192" r="4" style="fill: var(--surface)"/>
      </g>
      <g class="err-question"><circle cx="300" cy="84" r="26" style="fill: var(--surface); stroke: var(--ink)" stroke-width="3"/><text x="300" y="96" text-anchor="middle" font-size="34" font-weight="800" style="fill: var(--accent-text)">?</text></g>
      <rect x="250" y="172" width="100" height="10" rx="2" style="stroke: var(--line-2)" stroke-width="3" stroke-dasharray="6 6"/>
    <% } else if (kind === 'locked') { %>
      <!-- A barrier arm across the aisle -->
      <rect x="70" y="120" width="26" height="80" rx="4" style="fill: var(--ink)"/>
      <g class="err-barrier"><rect x="92" y="126" width="260" height="16" rx="8" style="fill: var(--surface); stroke: var(--ink)" stroke-width="3"/>
        <% for (let i = 0; i < 7; i++) { %><rect x="<%= 104 + i * 36 %>" y="128" width="16" height="12" style="fill: var(--bad)"/><% } %></g>
      <g class="err-lock"><rect x="276" y="60" width="52" height="42" rx="8" style="fill: var(--accent); stroke: var(--ink)" stroke-width="3"/>
        <path d="M287 60 V48 a15 15 0 0 1 30 0 V60" style="stroke: var(--ink)" stroke-width="4"/>
        <circle cx="302" cy="80" r="5" style="fill: var(--ink)"/></g>
    <% } else { %>
      <!-- A toppled carton -->
      <g class="err-box"><g transform="rotate(-14 210 150)"><rect x="160" y="110" width="100" height="78" rx="4" fill="#d8a863" style="stroke: var(--ink)" stroke-width="3"/>
        <rect x="200" y="111" width="20" height="76" fill="#f3d9a4"/></g></g>
      <path d="M290 186 l14 -10 M306 190 l10 -4 M120 188 l-12 -8" style="stroke: var(--muted)" stroke-width="3"/>
    <% } %>
  </svg>

  <p class="eyebrow mt-8"><%= kicker %> · <%= code %></p>
  <h1 class="mt-2 font-display text-[clamp(2rem,1.5rem+2vw,3rem)] font-bold tracking-[-0.035em] leading-[1.05]"><%= heading %></h1>
  <p class="mt-3 max-w-md text-muted"><%= text %></p>
  <div class="mt-8 flex flex-col sm:flex-row gap-3">
    <% if (loggedIn) { %>
      <a href="/dashboard" class="btn btn-primary btn-lg"><%- icon('dashboard', 'w-5 h-5') %> Back to dashboard</a>
    <% } else { %>
      <a href="/" class="btn btn-primary btn-lg">Go to the home page</a>
      <a href="/auth/login" class="btn btn-secondary btn-lg">Sign in</a>
    <% } %>
    <button type="button" class="btn btn-ghost btn-lg" onclick="history.length > 1 ? history.back() : (location.href = '/')">← Go back</button>
  </div>
</main>
<div id="toast-root" class="fixed z-[70] bottom-5 right-3 sm:right-5 w-[22rem] max-w-[calc(100vw-1.5rem)] flex flex-col gap-2" aria-live="polite"></div>
</body>
</html>
