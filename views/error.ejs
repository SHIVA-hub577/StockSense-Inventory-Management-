<%- include('layout/header') %>

<main class="flex-grow flex items-center justify-center p-4">
  <div class="w-full max-w-md glass-card rounded-2xl shadow-2xl p-8 text-center space-y-6 border border-red-500/20">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-red-500/10 text-red-400 ring-1 ring-red-500/30">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
      </svg>
    </div>

    <div class="space-y-2">
      <h1 class="text-2xl font-bold text-white"><%= typeof title !== 'undefined' ? title : 'Access Denied' %></h1>
      <p class="text-sm text-slate-400"><%= typeof message !== 'undefined' ? message : 'You do not have permission to view this page.' %></p>
    </div>

    <div class="pt-4 border-t border-slate-800">
      <a 
        href="/dashboard" 
        class="inline-block px-6 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-semibold text-sm transition-all"
      >
        Return to Dashboard
      </a>
    </div>
  </div>
</main>

<%- include('layout/footer') %>
