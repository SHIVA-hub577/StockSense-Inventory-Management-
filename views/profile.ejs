<%- include('layout/app-top') %>
<% const isManager = user.role === 'manager'; %>

<h1 class="text-2xl font-bold text-white tracking-tight">My profile</h1>

<div class="grid lg:grid-cols-3 gap-6">
  <section class="card p-6 space-y-5">
    <div class="flex items-center gap-4">
      <span class="w-16 h-16 rounded-full flex items-center justify-center text-xl font-bold <%= isManager ? 'bg-purple-500/20 text-purple-300' : 'bg-amber-500/20 text-amber-300' %>"><%= initials(user.name) %></span>
      <div>
        <p class="text-lg font-bold text-white"><%= user.name %></p>
        <span class="badge <%= isManager ? 'bg-purple-500/10 text-purple-400 border-purple-500/30' : 'bg-amber-500/10 text-amber-400 border-amber-500/30' %>"><%= isManager ? 'Inventory Manager' : 'Warehouse Staff' %></span>
      </div>
    </div>
    <dl class="space-y-3 text-sm">
      <div><dt class="text-slate-500">Email</dt><dd class="text-slate-200"><%= user.email %></dd></div>
      <div><dt class="text-slate-500">Phone</dt><dd class="text-slate-200"><%= user.phone || '—' %></dd></div>
      <div><dt class="text-slate-500">Member since</dt><dd class="text-slate-200"><%= fmtDate(user.createdAt) %></dd></div>
    </dl>
    <div class="pt-4 border-t border-slate-800 flex flex-wrap gap-2">
      <a href="/auth/forgot-password" class="btn btn-secondary btn-sm">Change password</a>
      <a href="/auth/logout" class="btn btn-danger btn-sm"><%- icon('logout', 'w-4 h-4') %> Sign out</a>
    </div>
  </section>

  <section class="lg:col-span-2 space-y-6">
    <div class="grid sm:grid-cols-2 gap-4">
      <div class="card p-5">
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Operations created</p>
        <p class="mt-2 text-3xl font-bold text-white tabular-nums"><%= stats.created %></p>
      </div>
      <div class="card p-5">
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Operations validated</p>
        <p class="mt-2 text-3xl font-bold text-emerald-400 tabular-nums"><%= stats.validated %></p>
      </div>
    </div>

    <div class="card overflow-hidden">
      <h2 class="px-4 py-3 border-b border-slate-800 text-sm font-semibold text-white">My recent activity</h2>
      <% if (recent.length === 0) { %>
        <p class="p-6 text-sm text-slate-400">No operations yet.</p>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="min-w-full">
            <tbody>
              <% recent.forEach((op) => { %>
                <tr class="border-t first:border-t-0 border-slate-800">
                  <td class="td"><a href="/operations/<%= op._id %>" class="font-mono text-blue-300 hover:text-blue-200"><%= op.reference %></a></td>
                  <td class="td text-slate-400"><%= OPERATION_META[op.type].label %><%= op.partner ? ' · ' + op.partner : '' %></td>
                  <td class="td"><span class="badge <%= STATUS_META[op.status].classes %>"><%= STATUS_META[op.status].label %></span></td>
                  <td class="td text-slate-500 text-right whitespace-nowrap"><%= fmtDateTime(op.updatedAt) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <div class="card p-5 space-y-3">
      <h2 class="text-sm font-semibold text-white">What your role can do</h2>
      <ul class="text-sm text-slate-300 space-y-2 list-disc pl-5">
        <% if (isManager) { %>
          <li>Create, edit and archive products, categories and reordering rules</li>
          <li>Run receipts, deliveries and internal transfers</li>
          <li>Validate inventory adjustments (stock count corrections)</li>
        <% } else { %>
          <li>View products, stock levels and forecasts</li>
          <li>Receive goods, pick/pack/validate deliveries and move stock between locations</li>
          <li>Count stock - an Inventory Manager validates the adjustment</li>
        <% } %>
      </ul>
    </div>
  </section>
</div>

<%- include('layout/app-bottom') %>
